                    </button>
                  ))}
                </div>
              </div>

              {/* Seçilen tarihin geçerli çalışma saatleri: eleman kendi
                  saatini seçmişse onlar, yoksa işletme saati */}
              {effectiveHours && (
                <div className="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 rounded-2xl border border-[var(--brand-border)] bg-[var(--brand-soft)] px-4 py-2.5 text-xs font-semibold text-[var(--brand-text)]">
                  <Clock size={14} className="shrink-0" />
                  <span>
                    {effectiveHours.source === "staff"
                      ? `${effectiveHours.name}${lang === "tr" ? " · çalışma saatleri" : "'s working hours"}: `
                      : lang === "tr"
                        ? "İşletme saatleri: "
                        : "Business hours: "}
                  </span>
                  <span>
                    {effectiveHours.hours.isOpen
                      ? `${effectiveHours.hours.openTime} – ${effectiveHours.hours.closeTime}`
                      : lang === "tr"
                        ? "Kapalı"
                        : "Closed"}
                  </span>
                </div>
              )}

              {/* Slots Grid */}
              <div className="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2.5">
                {filteredSlots.length > 0 ? (
                  filteredSlots.map((time) => {
                    const isBooked = isSlotBusy(time);
                    const isSelected = selectedTime === time;

                    return (
                      <button
                        key={time}
                        disabled={isBooked}
                        onClick={() => {
                          clearBookingError();
                          setSelectedTime(time);
                          // Adımlar 1 tabanlıdır: 3 = Tarih & Saat, 4 = Onay & Not.
                          // Burada 3 yazıyordu, yani kullanıcı zaten 3. adımda
                          // olduğu için saat seçmek HİÇBİR ŞEY yapmıyordu ve
                          // akış otomatik ilerlemiyordu. Kısa gecikme, seçim
                          // animasyonunun görünmesini sağlar.
                          setTimeout(() => {
                            setStep(4);
                          }, 220);
                        }}
                        className={`py-3 rounded-2xl text-xs sm:text-sm font-black border transition-all ${
                          isSelected
                            ? "bg-[var(--brand)] border-[var(--brand)] text-white shadow-md shadow-[color:var(--brand-shadow)] scale-[1.04]"
                            : isBooked
                              ? "bg-gray-100 dark:bg-slate-800/40 border-transparent text-gray-300 dark:text-slate-600 cursor-not-allowed line-through"
                              : "bg-white/80 dark:bg-slate-800/80 border-gray-200/70 dark:border-slate-700 text-gray-800 dark:text-slate-200 hover:border-[var(--brand)] hover:bg-[var(--brand-soft)] active:scale-95"
                        }`}
                      >
                        {time}
                      </button>
                    );
                  })
                ) : (
                  <div className="col-span-full py-8 text-center text-xs text-gray-400 bg-gray-50 dark:bg-slate-800/40 rounded-2xl">
                    {lang === "tr"
                      ? "Bu zaman diliminde müsait saat bulunmuyor."
                      : "No available slots in this time period."}
                  </div>
                )}
              </div>

              {/* Step 3 Bottom Navigation & Continue Action Bar */}
              <div className="mt-8 pt-5 border-t border-gray-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <button
                  type="button"
                  onClick={() => setStep(2)}
                  className="flex items-center gap-1.5 px-4 py-2.5 rounded-2xl border border-gray-200 dark:border-slate-700 text-xs font-bold text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors w-fit"
                >
                  <ChevronLeft size={16} />
                  <span>
                    {lang === "tr" ? "Hizmet Seçimine Dön" : "Back to Services"}
                  </span>
                </button>

                <button
                  type="button"
                  disabled={!selectedTime}
                  onClick={() => setStep(4)}
                  className="flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-[var(--brand)] hover:bg-[var(--brand-strong)] text-white font-black text-xs sm:text-sm shadow-md shadow-[color:var(--brand-shadow)] active:scale-95 disabled:opacity-40 disabled:pointer-events-none transition-all"
                >
                  <span>
                    {selectedTime
                      ? lang === "tr"
                        ? `Onay ve Not Adımına Geç (${selectedTime})`
                        : `Proceed to Confirm (${selectedTime})`
                      : lang === "tr"
                        ? "Lütfen Bir Saat Seçin"
                        : "Please Select a Time"}
                  </span>
                  <ArrowRight size={16} />
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* STEP 4: CONFIRMATION & NOTES */}
      {step === 4 && selectedService && selectedDate && selectedTime && (
        <div className="space-y-6 animate-in fade-in slide-in-from-bottom-2 duration-300">
          <div>
            <h2 className="text-xl font-bold text-gray-900 dark:text-white">
              {lang === "tr" ? "Randevu Özeti ve Onay" : "Appointment Summary"}
            </h2>
            <p className="text-xs text-gray-500 dark:text-slate-400">
              {lang === "tr"
                ? "Lütfen bilgilerinizi kontrol edin ve randevuyu onaylayın."
                : "Please review your details and confirm booking."}
            </p>
          </div>

          {/* Boarding-pass Style Summary Card */}
          <div className="relative overflow-hidden rounded-[32px] bg-white/80 dark:bg-slate-900/80 backdrop-blur-3xl border border-white/60 dark:border-slate-800/80 p-6 sm:p-8 shadow-lg">
            <div className="flex items-center justify-between pb-6 border-b border-dashed border-gray-200 dark:border-slate-800">
              <div className="flex items-center gap-3">
                <div className="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-white dark:border-slate-800 shadow-sm bg-[var(--brand-soft)] text-[var(--brand-text)] font-black text-lg">
                  {tenant.profile_image_url ? (
                    // eslint-disable-next-line @next/next/no-img-element
                    <img
                      src={tenant.profile_image_url}
                      alt={tenant.name}
                      className="h-full w-full object-cover"
                    />
                  ) : (
                    tenant.name.charAt(0).toUpperCase()
                  )}
                </div>
                <div>
                  <h3 className="font-bold text-gray-900 dark:text-white text-base">
                    {tenant.name}
                  </h3>
                  <p className="text-xs text-gray-400">
                    {lang === "tr"
                      ? "Doğrulanmış İşletme"
                      : "Verified Business"}
                  </p>
                </div>
              </div>

              <div className="text-right">
                <span className="text-xs text-gray-400 block font-medium">
                  {lang === "tr" ? "Toplam Ücret" : "Total Price"}
                </span>
                <span className="text-2xl font-black text-emerald-600 dark:text-emerald-400">
                  ₺{selectedService.price}
                </span>
              </div>
            </div>

            <div className="grid grid-cols-2 gap-4 py-6 border-b border-dashed border-gray-200 dark:border-slate-800 text-xs sm:text-sm">
              <div>
                <span className="text-gray-400 block mb-1">
                  {lang === "tr" ? "Seçilen Hizmet" : "Selected Service"}
                </span>
                <p className="font-bold text-gray-800 dark:text-slate-200">
                  {selectedService.name}
                </p>
                <span className="text-xs text-[var(--brand-text)] font-semibold">
                  {getServiceDuration(selectedService)}{" "}
                  {lang === "tr" ? "dakika" : "minutes"}
                </span>
              </div>

              {selectedStaff && (
                <div>
                  <span className="text-gray-400 block mb-1">
                    {lang === "tr" ? "Eleman" : "Staff"}
                  </span>
                  <p className="font-bold text-gray-800 dark:text-slate-200">
                    {selectedStaff.full_name ?? "-"}
                  </p>
                  {selectedStaff.role === "owner" && (
                    <span className="inline-flex items-center gap-1 text-xs font-bold text-amber-600 dark:text-amber-400">
                      <Crown size={12} strokeWidth={2.5} />
                      {lang === "tr" ? "İşletme Sahibi" : "Owner"}
                    </span>
                  )}
                </div>
              )}

              <div>
                <span className="text-gray-400 block mb-1">
                  {lang === "tr" ? "Tarih ve Saat" : "Date & Time"}
                </span>
                <p className="font-bold text-gray-800 dark:text-slate-200">
                  {format(selectedDate, "dd MMMM yyyy, EEEE", {
                    locale: lang === "tr" ? tr : enUS,
                  })}
                </p>
                <span className="text-xs text-[var(--brand-text)] font-bold">
                  {selectedTime}
                </span>
              </div>
            </div>

            {/* Note input */}
            <div className="pt-6">
              <label className="block text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-2">
                {lang === "tr"
                  ? "İşletmeye İletmek İstediğiniz Not (Opsiyonel)"
                  : "Note to Business (Optional)"}
              </label>
              <textarea
                value={note}
                onChange={(e) => setNote(e.target.value)}
                placeholder={
                  lang === "tr"
                    ? "Örn: İlk defa geleceğim, özel bir talebim var..."
                    : "Any special requests or instructions..."
                }
                rows={3}
                className="w-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-3.5 text-xs sm:text-sm text-gray-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-[var(--brand)] resize-none"
              />
            </div>

            {/* Sunucu hatası (ör. saat artık müsait değil): alert() yerine
                satır içi, kapatılabilir uyarı — mobilde tarayıcı diyaloğu
                akışı kesiyordu ve mesaj fark edilmiyordu. */}
            {bookingError && (
              <div
                role="alert"
                className="mt-6 flex items-start gap-2.5 rounded-2xl border border-red-200 bg-red-50 p-3.5 dark:border-red-500/30 dark:bg-red-950/40"
              >
                <AlertCircle
                  size={16}
                  className="mt-0.5 shrink-0 text-red-600 dark:text-red-400"
                />
                <p className="flex-1 text-[12.5px] font-semibold leading-snug text-red-700 dark:text-red-300">
                  {bookingError}
                </p>
                <button
                  type="button"
                  onClick={() => setBookingError(null)}
                  aria-label={lang === "tr" ? "Kapat" : "Dismiss"}
                  className="shrink-0 rounded-full px-1.5 text-red-500 active:scale-90 dark:text-red-400"
                >
                  ×
                </button>
              </div>
            )}

            {/* Action Buttons */}
            <div className="mt-8 flex items-center gap-3">
              <button
                type="button"
                onClick={() => setStep(3)}
                className="inline-flex items-center justify-center gap-2 pl-4 pr-5 py-3.5 rounded-2xl border border-slate-200/80 dark:border-slate-700 bg-white/60 dark:bg-slate-800/60 backdrop-blur-md text-sm font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/80 shadow-xs hover:shadow-sm active:scale-95 transition-all cursor-pointer select-none shrink-0"
              >
                <ChevronLeft
                  size={18}
                  className="-ml-0.5 text-slate-500 dark:text-slate-400"
                />
                <span>{lang === "tr" ? "Geri" : "Back"}</span>
              </button>

              <button
                type="button"
                disabled={bookingLoading}
                onClick={handleBook}
                className="flex-1 flex items-center justify-center gap-2 py-3.5 px-6 rounded-2xl bg-[var(--brand)] hover:bg-[var(--brand-strong)] text-white text-sm font-black shadow-lg shadow-[color:var(--brand-shadow)] hover:-translate-y-0.5 active:scale-95 transition-all disabled:opacity-50"
              >                {bookingLoading ? (
                  <Loader2 className="animate-spin" size={18} />
                ) : (
                  <CalendarIcon size={18} />
                )}
                <span>
                  {bookingLoading
                    ? lang === "tr"
                      ? "Randevu Oluşturuluyor..."
                      : "Booking..."
                    : lang === "tr"
                      ? "Randevuyu Onayla"
                      : "Confirm Appointment"}
                </span>
              </button>
            </div>
          </div>
        </div>
      )}

      {currentUserId && (
        <RequirePhoneModal
          isOpen={showPhoneModal}
          onSuccess={() => {
            setShowPhoneModal(false);
            handleBook();
          }}
        />
      )}
    </div>
  );
}
</file>

<file path="src/app/login/page.tsx">
"use client";

import { useState, useEffect, Suspense } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import Link from "next/link";
import { LogIn, Loader2 } from "lucide-react";
import { createClient } from "@/utils/supabase/client";
import { useLanguage } from "@/context/LanguageContext";
import {
  inspectTrMobile,
  trMobileErrorMessage,
  TR_MOBILE_PLACEHOLDER,
} from "@/lib/phone";

function GoogleIcon({ className = "h-5 w-5" }: { className?: string }) {
  return (
    <svg className={className} viewBox="0 0 24 24" fill="none">
      <path
        fill="#4285F4"
        d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"
      />
      <path
        fill="#34A853"
        d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.35 24 12 24z"
      />
      <path
        fill="#FBBC05"
        d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.16 0 9.98 0 12s.45 3.84 1.25 5.42l4.03-3.15z"
      />
      <path
        fill="#EA4335"
        d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"
      />
    </svg>
  );
}

function LoginForm() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const supabase = createClient();
  const { t, lang } = useLanguage();

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);
  const [isRegister, setIsRegister] = useState(false);
  const [fullName, setFullName] = useState("");
  const [nickname, setNickname] = useState("");
  const [phone, setPhone] = useState("");

  // Check URL params for errors or register mode
  useEffect(() => {
    const errorParam = searchParams.get("error");
    if (errorParam) {
      if (errorParam === "auth_callback_failed") {
        setError(t("login.google_error") || "Giriş işlemi tamamlanamadı. Lütfen tekrar deneyin.");
      } else {
        setError(decodeURIComponent(errorParam));
      }
    }

    const mode = searchParams.get("mode") || searchParams.get("register");
    if (mode === "register" || mode === "true" || mode === "1") {
      setIsRegister(true);
    }
  }, [searchParams, t]);

  const handleGoogleLogin = async () => {
    setError(null);
    setGoogleLoading(true);

    try {
      const next = searchParams.get("next");
      const redirectTo = `${window.location.origin}/auth/callback${
        next ? `?next=${encodeURIComponent(next)}` : ""
      }`;

      const { error: oauthError } = await supabase.auth.signInWithOAuth({
        provider: "google",
        options: {
          redirectTo,
          queryParams: {
            access_type: "offline",
            prompt: "consent",
          },
        },
      });

      if (oauthError) {
        throw oauthError;
      }
    } catch (err: any) {
      setError(err.message || t("login.google_error") || "Google ile bağlanırken bir sorun oluştu.");
      setGoogleLoading(false);
    }
  };

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    setLoading(true);

    try {
      const next = searchParams.get("next");

      if (isRegister) {
        // Numara biçim + uydurma desen kontrolü (bkz. src/lib/phone.ts)
        const phoneCheck = inspectTrMobile(phone);
        if (!phoneCheck.ok) {
          throw new Error(trMobileErrorMessage(phoneCheck.issue, lang));
        }

        // 1. Sunucu tarafında kullanıcıyı ve profili oluştur
        const res = await fetch("/api/auth/register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password, fullName, nickname, phone: phoneCheck.phone }),
        });

        const resData = await res.json();
        if (!res.ok) {
          throw new Error(resData.error || "Kayıt olurken bir hata oluştu.");
        }

        // 2. Oturumu aç
        const { error: signInError } = await supabase.auth.signInWithPassword({
          email,
          password,
        });

        if (signInError) {
          throw new Error(signInError.message);
        }

        router.refresh();
        if (next && next.startsWith("/") && !next.startsWith("/login")) {
          router.push(next);
        } else {
          router.push("/discover");
        }
        return;
      }

      // Standart Giriş Yap Akışı
      const { error: signInError, data: authData } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (signInError) {
        throw new Error(t("login.error"));
      }

      let userRole = "customer";
      if (authData?.user) {
        const { data: profile } = await supabase
          .from("profiles")
          .select("role")
          .eq("id", authData.user.id)
          .single();
        if (profile) userRole = profile.role;
      }

      router.refresh();
      if (next && next.startsWith("/") && !next.startsWith("/login")) {
        router.push(next);
      } else if (userRole === "customer") {
        router.push("/discover");
      } else {
        router.push("/dashboard");
      }
    } catch (err: any) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="page-fill relative flex items-center justify-center px-4">
      {/* Background gradient */}
      <div className="absolute inset-0 bg-gradient-to-br from-indigo-100 via-white to-purple-100" />

      {/* Decorative circles */}
      <div className="absolute -left-32 -top-32 h-96 w-96 rounded-full bg-gradient-to-br from-indigo-300/30 to-purple-300/30 blur-3xl" />
      <div className="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-gradient-to-br from-purple-300/30 to-pink-300/30 blur-3xl" />

      <div className="relative w-full max-w-sm">
        {/* Logo */}
        <div className="mb-8 text-center">
          <div className="relative mx-auto flex h-14 w-14 items-center justify-center overflow-hidden rounded-2xl shadow-lg shadow-indigo-200 border border-gray-100">
            <img src="/logo-light.png" alt="Randera Logo" className="h-full w-full object-cover bg-white" />
          </div>
          <h1 className="mt-4 text-2xl font-semibold text-gray-800">
            {isRegister ? (lang === "tr" ? "Kayıt Ol" : "Sign Up") : t("login.title")}
          </h1>
          <p className="mt-1 text-sm text-gray-500">
            {t("login.subtitle")}
          </p>
        </div>

        {/* Card */}
        <div className="rounded-2xl border border-white/40 bg-white/70 p-6 shadow-xl shadow-black/5 backdrop-blur-2xl">
          {/* Google Auth Button */}
          <button
            type="button"
            onClick={handleGoogleLogin}
            disabled={googleLoading || loading}
            className="flex w-full items-center justify-center gap-3 rounded-lg border border-gray-200 bg-white/90 px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm transition-all hover:bg-white hover:border-gray-300 hover:shadow-md active:scale-[0.99] disabled:opacity-50"
          >
            {googleLoading ? (
              <Loader2 className="h-5 w-5 animate-spin text-indigo-600" />
            ) : (
              <GoogleIcon className="h-5 w-5" />
            )}
            <span>
              {googleLoading
                ? (lang === "tr" ? "Bağlanıyor..." : "Connecting...")
                : isRegister
                ? (t("login.google_signup") || "Google ile Kayıt Ol")
                : (t("login.google_signin") || "Google ile Giriş Yap")}
            </span>
          </button>

          {/* Divider */}
          <div className="relative my-4">
            <div className="absolute inset-0 flex items-center">
              <div className="w-full border-t border-gray-200/80" />
            </div>
            <div className="relative flex justify-center text-xs uppercase">
              <span className="bg-white/90 px-2 text-gray-500 rounded-full font-medium">
                {t("login.or_email") || (lang === "tr" ? "veya e-posta ile" : "or with email")}
              </span>
            </div>
          </div>

          <form onSubmit={handleLogin} className="space-y-4">
            {isRegister && (
              <div>
                <label className="block text-sm font-medium text-gray-600">
                  {lang === "tr" ? "Ad Soyad" : "Full Name"}
                </label>
                <input
                  type="text"
                  required
                  value={fullName}
                  onChange={(e) => setFullName(e.target.value)}
                  placeholder="Ahmet Yılmaz"
                  className="mt-1 block w-full rounded-lg border border-white/40 bg-white/60 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 backdrop-blur-xl focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400/30"
                />
              </div>
            )}

            {isRegister && (
              <div>
                <label className="block text-sm font-medium text-gray-600">
                  {lang === "tr" ? "Kullanıcı Adı" : "Username"}
                </label>
                <input
                  type="text"
                  required
                  value={nickname}
                  onChange={(e) => setNickname(e.target.value)}
                  placeholder="ahmet_yilmaz"
                  className="mt-1 block w-full rounded-lg border border-white/40 bg-white/60 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 backdrop-blur-xl focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400/30"
                />
              </div>
            )}

            {isRegister && (
              <div>
                <label className="block text-sm font-medium text-gray-600">
                  {lang === "tr" ? "Telefon Numarası" : "Phone Number"}{" "}
                  <span className="text-red-500 font-bold">*</span>
                </label>
                <input
                  type="tel"
                  required
                  value={phone}
                  onChange={(e) => setPhone(e.target.value)}
                  placeholder={TR_MOBILE_PLACEHOLDER}
                  className="mt-1 block w-full rounded-lg border border-white/40 bg-white/60 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 backdrop-blur-xl focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400/30"
                />
                <p className="mt-1 text-[11px] text-gray-500">
                  {lang === "tr"
                    ? "Aynı numara yalnızca bir hesapta kullanılabilir."
                    : "A number can only be used by one account."}
                </p>
              </div>
            )}

            <div>
              <label htmlFor="email" className="block text-sm font-medium text-gray-600">
                {t("login.email")}
              </label>
              <input
                id="email"
                type="email"
                required
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="ornek@email.com"
                className="mt-1 block w-full rounded-lg border border-white/40 bg-white/60 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 backdrop-blur-xl focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400/30"
              />
            </div>

            <div>
              <label htmlFor="password" className="block text-sm font-medium text-gray-600">
                {t("login.password")}
              </label>
              <input
                id="password"
                type="password"
                required
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="••••••••"
                className="mt-1 block w-full rounded-lg border border-white/40 bg-white/60 px-3 py-2.5 text-sm text-gray-800 placeholder-gray-400 backdrop-blur-xl focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400/30"
              />
            </div>

            {error && (
              <p className="rounded-lg bg-red-500/10 px-3 py-2 text-sm text-red-600 border border-red-200/50 backdrop-blur-xl">
                {error}
              </p>
            )}

            <button
              type="submit"
              disabled={loading || googleLoading}
              className="flex w-full items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-indigo-200 transition-all hover:from-indigo-600 hover:to-purple-700 hover:shadow-xl disabled:opacity-50"
            >
              {loading ? (
                <Loader2 className="h-4 w-4 animate-spin" />
              ) : (
                <LogIn size={18} />
              )}
              {loading
                ? t("login.logging_in")
                : isRegister
                ? (lang === "tr" ? "Hesap Oluştur" : "Create Account")
                : t("login.signin")}
            </button>
            
            <div className="text-center mt-4 text-sm text-gray-500">
              {isRegister ? (
                <>
                  {lang === "tr" ? "Zaten hesabınız var mı?" : "Already have an account?"}{" "}
                  <button
                    type="button"
                    onClick={() => {
                      setIsRegister(false);
                      setError(null);
                    }}
                    className="text-indigo-600 font-semibold underline"
                  >
                    {lang === "tr" ? "Giriş Yap" : "Log In"}
                  </button>
                </>
              ) : (
                <>
                  {lang === "tr" ? "Hesabınız yok mu?" : "Don't have an account?"}{" "}
                  <button
                    type="button"
                    onClick={() => {
                      setIsRegister(true);
                      setError(null);
                    }}
                    className="inline-flex min-h-6 items-center px-1 font-semibold text-indigo-600 underline"
                  >
                    {lang === "tr" ? "Kayıt Ol" : "Sign Up"}
                  </button>
                </>
              )}
            </div>
          </form>
        </div>

        {/* Legal Links */}
        <div className="mt-6 flex items-center justify-center gap-3 text-center text-xs text-gray-500">
          <Link href="/privacy" className="flex min-h-6 items-center px-1 hover:text-indigo-600 transition-colors underline underline-offset-2">
            {lang === "tr" ? "Gizlilik Politikası" : "Privacy Policy"}
          </Link>
          <span>•</span>
          <Link href="/terms" className="flex min-h-6 items-center px-1 hover:text-indigo-600 transition-colors underline underline-offset-2">
            {lang === "tr" ? "Kullanım Koşulları" : "Terms of Service"}
          </Link>
        </div>
      </div>
    </div>
  );
}

export default function LoginPage() {
  return (
    <Suspense
      fallback={
        <div className="page-fill flex items-center justify-center bg-gradient-to-br from-indigo-100 via-white to-purple-100">
          <Loader2 className="h-8 w-8 animate-spin text-indigo-600" />
        </div>
      }
    >
      <LoginForm />
    </Suspense>
  );
}
</file>

