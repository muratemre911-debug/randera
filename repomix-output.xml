                      className={`relative aspect-video w-full overflow-hidden ${
                        tenant.profile_image_url ? '' : getPlaceholderColor(tenant.name)
                      }`}
                    >
                      {/* Floating Sektör Rozeti */}
                      {sectorLabel && (
