                >
                  <MessageCircle size={16} />
                  {lang === "tr" ? "WhatsApp Mesajı" : "WhatsApp Message"}
                </a>
              )}

              {selectedCustomer.phone && (
                <a
                  href={`tel:${selectedCustomer.phone}`}
