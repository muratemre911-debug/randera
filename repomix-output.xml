  "pwa.ios_desc": "Safari'de alttaki Paylaş simgesine dokun, sonra \"Ana Ekrana Ekle\"yi seç.",
  "pwa.update_ready": "Yeni sürüm hazır",
  "pwa.update_button": "Yenile",
  "pwa.offline_title": "İnternet bağlantısı yok",
