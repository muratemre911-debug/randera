                  className={`group relative flex items-center justify-between p-5 rounded-3xl border transition-all text-left ${
                    isSelected
                      ? "bg-[var(--brand-soft)] border-[var(--brand)] shadow-md ring-2 ring-[var(--brand)]/20"
