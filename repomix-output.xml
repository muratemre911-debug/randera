<file path="src/components/layout/SwipePager.tsx">
"use client";

import {
  forwardRef,
  useCallback,
  useEffect,
  useLayoutEffect,
  useRef,
  useState,
  type ReactNode,
} from "react";
import { usePathname, useRouter } from "next/navigation";

/**
 * Yatay kaydırma (swipe) ile sekmeler arasında geçiş yapan sayfa kabı.
 *
 * Neden gerekli: uygulama tek bir sabit kabuk (fixed shell) içinde çalışır ve
 * alt navigasyon sekmeleri arasında geçiş yalnızca tıklamayla yapılabiliyordu.
 * Dokunmatikte parmakla sayfa çevirmek, uygulamayı "yerel uygulama" gibi
 * hissettiren en temel hareketlerden biri.
 *
 * Davranış kuralları (mobil tarayıcıyla çakışmamak için kritik):
 *  - Kaydırma yalnızca listedeki TAM eşleşen sekmelerde çalışır; alt sayfalarda
 *    (işletme detayı, randevu akışı) devre dışı kalır.
 *  - Yatay niyet, dikey hareketin en az {@link AXIS_RATIO} katı olmalı; aksi
 *    halde jest dikey kaydırmaya bırakılır.
 *  - Yatay kaydırılabilir bir öğe (ör. filtre çipleri) veya harita üzerinde
 *    başlayan jestler yok sayılır — oralarda kendi kaydırması çalışsın.
 *  - `data-no-swipe` taşıyan torunlar (modallar, harita) jesti engeller.
 *  - Masaüstünde hiçbir etkisi yoktur (yalnızca dokunma olayları dinlenir).
 */

const AXIS_RATIO = 1.35; // yatay niyet eşiği
const AXIS_SLOP = 8; // karar vermeden önceki ölü bölge (px)
const MIN_DISTANCE = 48; // en az bu kadar sürüklenmeli (px)
const QUICK_MS = 500; // hızlı "flick" süresi (ms)
const COMMIT_RATIO = 0.18; // genişliğin bu oranı geçilirse geçiş yapılır
const MAX_DRAG_RATIO = 0.32; // fazla sürüklemeyi sınırla
const DAMPING = 0.55; // parmağın altında yumuşak takip
const EXIT_MS = 170; // sayfadan çıkış animasyonu
const ENTER_MS = 300; // yeni sayfanın giriş animasyonu

export interface SwipeTab {
  href: string;
}

interface SwipePagerProps
  extends Omit<React.ComponentPropsWithoutRef<"main">, "children"> {
  /** Kaydırmayla gezilebilecek sekmeler, görsel sırayla. */
  tabs: SwipeTab[];
  children: ReactNode;
}

/** Modal / harita / düzenlenen alan gibi jesti engelleyen atalar var mı? */
function hasSwipeBlocker(target: EventTarget | null): boolean {
  let el: Element | null = target instanceof Element ? target : null;
  while (el) {
    if (el.hasAttribute("data-no-swipe")) return true;
    if (el.getAttribute("role") === "dialog") return true;

    const tag = el.tagName;
    // `select`: yerel seçici açılır, dokunma jesti ona ait.
    if (tag === "SELECT") return true;
    // Metin alanları: YALNIZCA o an düzenleniyorsa (odaktaysa) engellenir.
    // Aksi halde profil gibi form ağırlıklı sayfalarda kaydırma jesti
    // tamamen ölürdi — odakta olmayan bir alanda yatay sürükleme zaten
    // yapılacak bir şey değil.
    if (
      (tag === "INPUT" || tag === "TEXTAREA") &&
      el === document.activeElement
    ) {
      return true;
    }

    el = el.parentElement;
  }
  return false;
}

/** Jest, yatay kaydırılabilir bir alanın üzerinde mi başladı? */
function findHorizontalScroller(target: EventTarget | null): HTMLElement | null {
  let el: Element | null = target instanceof Element ? target : null;
  while (el && el !== document.body) {
    if (el instanceof HTMLElement && el.scrollWidth > el.clientWidth + 4) {
      const overflowX = getComputedStyle(el).overflowX;
      if (overflowX === "auto" || overflowX === "scroll") return el;
    }
    el = el.parentElement;
  }
  return null;
}

const SwipePager = forwardRef<HTMLElement, SwipePagerProps>(
  function SwipePager({ tabs, className, children, ...mainProps }, ref) {
    const pathname = usePathname();
    const router = useRouter();
    const paneRef = useRef<HTMLElement | null>(null);
    const [enterFrom, setEnterFrom] = useState<"left" | "right" | null>(null);

    // Yalnızca tam eşleşen sekme yollarında kaydırma açılır.
    const index = tabs.findIndex((tab) => tab.href === pathname);

    const setRefs = useCallback(
      (node: HTMLElement | null) => {
        paneRef.current = node;
        if (typeof ref === "function") ref(node);
        else if (ref) ref.current = node;
      },
      [ref],
    );

    // Sayfa değiştiğinde kabı hemen başlangıç konumuna al: yeni sayfa, çıkış
    // animasyonunun bittiği kaydırılmış konumda bir kare bile görünmemeli.
    // (useLayoutEffect: tarayıcı boyamadan önce çalışır.)
    useLayoutEffect(() => {
      const pane = paneRef.current;
      if (!pane) return;
      pane.style.transition = "none";
      pane.style.transform = "translate3d(0,0,0)";
    }, [pathname]);

    // Giriş animasyonu bitince sınıfı kaldır (animasyon transform'u sıfırlar).
    useEffect(() => {
      if (!enterFrom) return;
      const timer = window.setTimeout(() => setEnterFrom(null), ENTER_MS);
      return () => window.clearTimeout(timer);
    }, [enterFrom]);

    // Komşu sekme yolları efekt bağımlılığı olarak kullanılır (dizi kimliği her
    // render'da değişebildiği için doğrudan `tabs`'a bağlanmak efekti sürekli
    // yeniden kurardı).
    const previousHref = index > 0 ? tabs[index - 1].href : null;
    const nextHref = index >= 0 && index < tabs.length - 1 ? tabs[index + 1].href : null;

    useEffect(() => {
      const pane = paneRef.current;
      if (!pane || index < 0) return;

      const previous = previousHref ? { href: previousHref } : undefined;
      const next = nextHref ? { href: nextHref } : undefined;

      let tracking = false;
      let axis: "x" | "y" | null = null;
      let startX = 0;
      let startY = 0;
      let startTime = 0;
      let deltaX = 0;
      /** Jest yatay kaydırılabilir bir alanda başladıysa o alan. */
      let hScroller: HTMLElement | null = null;
      /**
       * Kenar devri (edge handoff): yatay kaydırılabilir alan kendi ucuna
       * ulaştıysa jest sayfaya devredilir. Böylece takvim/filtre çubuğu gibi
       * alanlar hem kendi içinde kaydırılır hem de sona gelindiğinde sekme
       * değiştirilebilir (yerel uygulamalardaki davranış).
       */
      let handedOff = false;

      const paneWidth = () => pane.clientWidth || window.innerWidth;

      const clearTransform = () => {
        pane.style.transition = "";
        pane.style.transform = "";
      };

      const settleBack = () => {
        pane.style.transition = `transform 230ms cubic-bezier(0.22, 1, 0.36, 1)`;
        pane.style.transform = "translate3d(0,0,0)";
        window.setTimeout(clearTransform, 250);
      };

      const abort = () => {
        tracking = false;
        axis = null;
        handedOff = false;
        hScroller = null;
        clearTransform();
      };

      const onTouchStart = (event: TouchEvent) => {
        if (event.touches.length !== 1) return;
        if (hasSwipeBlocker(event.target)) return;

        const touch = event.touches[0];
        startX = touch.clientX;
        startY = touch.clientY;
        startTime = Date.now();
        deltaX = 0;
        axis = null;
        handedOff = false;
        hScroller = findHorizontalScroller(event.target);
        tracking = true;
        pane.style.transition = "none";
      };

      const onTouchMove = (event: TouchEvent) => {
        if (!tracking) return;
        if (event.touches.length !== 1) {
          abort();
          return;
        }

        const touch = event.touches[0];
        const moveX = touch.clientX - startX;
        const moveY = touch.clientY - startY;

        if (!axis) {
          if (Math.abs(moveX) < AXIS_SLOP && Math.abs(moveY) < AXIS_SLOP) return;
          if (Math.abs(moveX) > Math.abs(moveY) * AXIS_RATIO) {
            axis = "x";
          } else {
            // Dikey kaydırma: jesti tamamen bırak.
            abort();
            return;
          }
        }

        // Yatay kaydırılabilir bir alan varsa: yalnızca o alan kendi ucuna
        // dayanmışsa jest sayfaya geçer; aksi halde kaydırmayı o üstlenir.
        if (hScroller && !handedOff) {
          const atStart = hScroller.scrollLeft <= 0;
          const atEnd =
            hScroller.scrollLeft + hScroller.clientWidth >=
            hScroller.scrollWidth - 2;
          const wantsLeft = moveX < 0;
          const scrollerCanMove = wantsLeft ? !atEnd : !atStart;
          if (scrollerCanMove) {
            abort();
            return;
          }
          handedOff = true;
        }

        deltaX = moveX;
        const target = deltaX < 0 ? next : previous;
        // Karşı sekme yoksa neredeyse hiç hareket etmesin (kenarda direnç).
        const resistance = target ? DAMPING : DAMPING * 0.3;
        const limit = paneWidth() * MAX_DRAG_RATIO;
        const shifted = Math.max(
          -limit,
          Math.min(limit, deltaX * resistance),
        );

        pane.style.transform = `translate3d(${shifted}px,0,0)`;
      };

      const onTouchEnd = () => {
        if (!tracking) return;
        const wasHorizontal = axis === "x" && (handedOff || !hScroller);
        tracking = false;
        axis = null;

        if (!wasHorizontal) {
          clearTransform();
          return;
        }

        const target = deltaX < 0 ? next : previous;
        const travelled = Math.abs(deltaX);
        const elapsed = Date.now() - startTime;
        const farEnough =
          travelled > Math.max(MIN_DISTANCE, paneWidth() * COMMIT_RATIO);
        const quickFlick = elapsed < QUICK_MS && travelled > MIN_DISTANCE;

        if (!target || (!farEnough && !quickFlick)) {
          settleBack();
          return;
        }

        // Hedef sayfaya doğru kaydır, sonra rotayı değiştir.
        const exitTo = deltaX < 0 ? -paneWidth() : paneWidth();
        pane.style.transition = `transform ${EXIT_MS}ms ease-out`;
        pane.style.transform = `translate3d(${exitTo}px,0,0)`;
        setEnterFrom(deltaX < 0 ? "right" : "left");

        window.setTimeout(() => {
          router.push(target.href);
        }, EXIT_MS);
      };

      pane.addEventListener("touchstart", onTouchStart, { passive: true });
      pane.addEventListener("touchmove", onTouchMove, { passive: true });
      pane.addEventListener("touchend", onTouchEnd, { passive: true });
      pane.addEventListener("touchcancel", abort, { passive: true });

      return () => {
        pane.removeEventListener("touchstart", onTouchStart);
        pane.removeEventListener("touchmove", onTouchMove);
        pane.removeEventListener("touchend", onTouchEnd);
        pane.removeEventListener("touchcancel", abort);
        clearTransform();
      };
    }, [index, previousHref, nextHref, router]);

    return (
      <main
        ref={setRefs}
        {...mainProps}
        className={`${className ?? ""} ${
          enterFrom === "right"
            ? "animate-swipe-in-right"
            : enterFrom === "left"
              ? "animate-swipe-in-left"
              : ""
        }`}
      >
        {children}
      </main>
    );
  },
);

export default SwipePager;
</file>

<file path="src/components/layout/UserAvatar.tsx">
"use client";

import { useState } from "react";

/**
 * Sidebar / çekmece kullanıcı kimliği yardımcıları.
 *
 * Sol altta e-postanın yerine kullanıcı adı ve profil fotoğrafı gösterilir.
 * Hem işletme panelinde hem müşteri alanında aynı görünüm kullanılır.
 */
export function getDisplayName(
  fullName?: string | null,
  email?: string | null,
  fallback: string = "Randera"
): string {
  const name = (fullName || "").trim();
  if (name) return name;
  const mail = (email || "").trim();
  if (mail) return mail.split("@")[0];
  return fallback;
}

interface UserAvatarProps {
  /** Profil fotoğrafı URL'i (profiles.avatar_url) */
  src?: string | null;
  fullName?: string | null;
  email?: string | null;
  /** Boyut/metin sınıfları, ör. "h-10 w-10 text-sm" */
  className?: string;
  shape?: "circle" | "rounded";
}

/** Profil fotoğrafı yoksa/yüklenmezse ismin ilk harfini gösterir. */
export default function UserAvatar({
  src,
  fullName,
  email,
  className = "h-10 w-10 text-sm",
  shape = "circle",
}: UserAvatarProps) {
  // Effect kullanmadan "bozuk görsel" takibi: kaynak değişince otomatik sıfırlanır
  const [failedSrc, setFailedSrc] = useState<string | null>(null);
  const displayName = getDisplayName(fullName, email);
  const showImage = Boolean(src) && failedSrc !== src;

  return (
    <div
      className={`flex shrink-0 items-center justify-center overflow-hidden bg-gradient-to-br from-indigo-400 to-purple-500 font-bold text-white shadow-sm ${
        shape === "circle" ? "rounded-full" : "rounded-2xl"
      } ${className}`}
    >
      {showImage ? (
        // eslint-disable-next-line @next/next/no-img-element
        <img
          src={src as string}
          alt={displayName}
          className="h-full w-full object-cover"
          onError={() => setFailedSrc(src ?? null)}
          referrerPolicy="no-referrer"
        />
      ) : (
        <span>{displayName.charAt(0).toUpperCase()}</span>
      )}
    </div>
  );
}
</file>

<file path="src/components/pwa/InstallBanner.tsx">
"use client";

/**
 * "Ana ekrana ekle" daveti.
 *
 * - Android / masaüstü Chromium: `beforeinstallprompt` yakalanır ve tek
 *   dokunuşla yerel kurulum diyaloğu açılır.
 * - iOS Safari: yerel bir kurulum API'si yok; kullanıcıya Paylaş → "Ana Ekrana
 *   Ekle" yolunu anlatan kısa bir yönerge gösterilir.
 * - Uygulama zaten standalone çalışıyorsa veya kullanıcı reddettiyse hiç
 *   gösterilmez (14 gün hatırlanır).
 */

import { useEffect, useState } from "react";
import { usePathname } from "next/navigation";
import { Share, Plus } from "lucide-react";
import { hasBottomNav } from "@/components/layout/shell";
import { isIOS, isStandalone } from "@/lib/pwa";
import { useLanguage } from "@/context/LanguageContext";

const DISMISS_KEY = "randera:pwa-install-dismissed";
const DISMISS_DAYS = 14;
const APPEAR_DELAY = 3000;

interface BeforeInstallPromptEvent extends Event {
  prompt: () => Promise<void>;
  userChoice: Promise<{ outcome: "accepted" | "dismissed" }>;
}

function isDismissed(): boolean {
  try {
    const raw = localStorage.getItem(DISMISS_KEY);
    if (!raw) return false;
    const at = Number(raw);
    if (!Number.isFinite(at)) return false;
    return Date.now() - at < DISMISS_DAYS * 24 * 60 * 60 * 1000;
  } catch {
    return true; // localStorage kapalıysa kullanıcıyı rahatsız etme
  }
}

export default function InstallBanner() {
  const { t } = useLanguage();
  const pathname = usePathname();
  const [promptEvent, setPromptEvent] =
    useState<BeforeInstallPromptEvent | null>(null);
  const [iosHint, setIosHint] = useState(false);
  const [visible, setVisible] = useState(false);

  useEffect(() => {
    if (isDismissed()) return;
    if (isStandalone()) return;

    const ua = window.navigator.userAgent;
    // iOS'ta öneri yalnızca Safari'de işe yarar (diğer tarayıcılar ana ekrana ekleyemez).
    const isIOSSafari = isIOS() && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);

    const timer = window.setTimeout(() => {
      if (isIOSSafari) {
        setIosHint(true);
        setVisible(true);
      }
    }, APPEAR_DELAY);

    const onBeforeInstall = (event: Event) => {
      event.preventDefault();
      setPromptEvent(event as BeforeInstallPromptEvent);
      setIosHint(false);
      setVisible(true);
    };
    window.addEventListener("beforeinstallprompt", onBeforeInstall);

    const onInstalled = () => {
      setVisible(false);
      setPromptEvent(null);
      try {
        localStorage.setItem(DISMISS_KEY, String(Date.now()));
      } catch {
        /* yok sayılır */
      }
    };
    window.addEventListener("appinstalled", onInstalled);

    return () => {
      window.clearTimeout(timer);
      window.removeEventListener("beforeinstallprompt", onBeforeInstall);
      window.removeEventListener("appinstalled", onInstalled);
    };
  }, []);

  const dismiss = () => {
    setVisible(false);
    try {
      localStorage.setItem(DISMISS_KEY, String(Date.now()));
    } catch {
      /* yok sayılır */
    }
  };

  const install = async () => {
    if (!promptEvent) return;
    try {
      await promptEvent.prompt();
      const choice = await promptEvent.userChoice;
      if (choice.outcome === "accepted") {
        setVisible(false);
      } else {
        dismiss();
      }
    } catch {
      dismiss();
    } finally {
      setPromptEvent(null);
    }
  };

  if (!visible || (!promptEvent && !iosHint)) return null;

  // Alt navigasyon varsa onun üstünde dur, yoksa güvenli alan kadar yukarıda.
  const bottom = hasBottomNav(pathname)
    ? "calc(env(safe-area-inset-bottom, 0px) + 4.9rem)"
    : "calc(env(safe-area-inset-bottom, 0px) + 1rem)";

  return (
    <div
      className="pointer-events-none fixed inset-x-0 z-[60] flex justify-center px-3 pb-1"
      style={{ bottom }}
    >
      <div className="animate-modal-in pointer-events-auto flex w-full max-w-md items-center gap-3 rounded-3xl border border-white/60 bg-white/90 p-3 shadow-[0_16px_40px_rgb(15,23,42,0.18)] backdrop-blur-2xl dark:border-slate-700/60 dark:bg-slate-900/90">
        <div className="h-11 w-11 shrink-0 overflow-hidden rounded-2xl border border-slate-200/60 dark:border-slate-700/60">
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src="/icon-192.png"
            alt=""
            width={44}
            height={44}
            className="h-full w-full object-cover"
          />
        </div>

        <div className="min-w-0 flex-1">
          <p className="text-[13.5px] font-bold leading-tight text-slate-900 dark:text-slate-100">
            {t("pwa.install_title")}
          </p>
          {iosHint ? (
            <p className="mt-0.5 flex flex-wrap items-center gap-1 text-[12px] leading-snug text-slate-500 dark:text-slate-400">
              <Share size={12} className="shrink-0" />
              <span>{t("pwa.ios_desc")}</span>
            </p>
          ) : (
            <p className="mt-0.5 text-[12px] leading-snug text-slate-500 dark:text-slate-400">
              {t("pwa.install_desc")}
            </p>
          )}
        </div>

        {!iosHint && (
          <button
            type="button"
            onClick={install}
            className="flex shrink-0 items-center gap-1 rounded-2xl bg-gradient-to-r from-indigo-500 to-purple-600 px-3.5 py-2 text-[13px] font-bold text-white shadow-md shadow-indigo-500/25 transition active:scale-95"
          >
            <Plus size={14} strokeWidth={3} />
            {t("pwa.install_button")}
          </button>
        )}

        <button
          type="button"
          onClick={dismiss}
          aria-label={t("pwa.install_later")}
          className="shrink-0 rounded-full px-2 py-1 text-[12px] font-semibold text-slate-400 transition active:scale-90 dark:text-slate-500"
        >
          {t("pwa.install_later")}
        </button>
      </div>
    </div>
  );
}
</file>

<file path="src/components/pwa/PwaManager.tsx">
"use client";

/**
 * PWA altyapısı.
 *
 * 1. Service worker'ı kaydeder ve yeni sürüm çıktığında kullanıcıya haber verir.
 * 2. `<meta name="theme-color">` etiketini aktif temaya göre günceller; böylece
 *    Android durum çubuğu / iOS üst barı uygulamanın zeminiyle aynı renkte olur.
 * 3. Uygulama ana ekrandan (standalone) açıldıysa `<html>` üzerine
 *    `pwa-standalone` sınıfı ekler — çentik/home-bar boşlukları buna göre verilir.
 *
 * Kurulum daveti (install banner) ayrı bileşende: `InstallBanner`.
 */

import { useEffect, useState } from "react";
import InstallBanner from "./InstallBanner";
import { isStandalone } from "@/lib/pwa";
import { useLanguage } from "@/context/LanguageContext";
import { useTheme } from "@/context/ThemeContext";

const THEME_COLORS = { light: "#f8fafc", dark: "#0b0d14" };

/**
 * Aktif temaya göre tarayıcı/çentik renklerini günceller.
 *
 * DİKKAT: `<meta name="theme-color">` etiketlerini SİLİP yeniden EKLEMEK
 * yasak. Bu etiketler `viewport` dışa aktarımıyla React tarafından üretilir;
 * React'in sahip olduğu düğümleri DOM'dan koparmak, sonraki gezinmelerde
 * React'in ebeveyn/çocuk eşlemesini bozar ve
 * "Cannot read properties of null (reading 'removeChild')" hatasıyla
 * istemci tarafı gezinmeyi tamamen durdurur. Bu yüzden yalnızca mevcut
 * etiketlerin nitelikleri yerinde güncellenir.
 */
function syncThemeColor(theme: "light" | "dark") {
  const color = THEME_COLORS[theme];
  const metas = document.querySelectorAll('meta[name="theme-color"]');
  metas.forEach((meta) => {
    // Medya sorgusu kaldırılır: tek ve kesin renk geçerli olsun.
    meta.removeAttribute("media");
    meta.setAttribute("content", color);
  });
}

export default function PwaManager() {
  const { theme } = useTheme();
  const { t } = useLanguage();
  const [waitingWorker, setWaitingWorker] = useState<ServiceWorker | null>(null);
  const [offline, setOffline] = useState(false);
  const [reloading, setReloading] = useState(false);

  // --- Tema rengi ---
  useEffect(() => {
    syncThemeColor(theme);
  }, [theme]);

  // --- Standalone (ana ekrandan açılış) tespiti ---
  useEffect(() => {
    const media = window.matchMedia("(display-mode: standalone)");
    const apply = () => {
      document.documentElement.classList.toggle(
        "pwa-standalone",
        isStandalone(),
      );
    };
    apply();
    media.addEventListener("change", apply);
    return () => media.removeEventListener("change", apply);
  }, []);

  // --- Service worker kaydı + güncelleme akışı ---
  useEffect(() => {
    if (!("serviceWorker" in navigator)) return;

    let registration: ServiceWorkerRegistration | undefined;
    let cancelled = false;

    const trackUpdates = (reg: ServiceWorkerRegistration) => {
      if (reg.waiting && navigator.serviceWorker.controller) {
        setWaitingWorker(reg.waiting);
      }
      reg.addEventListener("updatefound", () => {
        const installing = reg.installing;
        if (!installing) return;
        installing.addEventListener("statechange", () => {
          // controller varsa bu bir "güncelleme", ilk kurulum değil.
          if (installing.state === "installed" && navigator.serviceWorker.controller) {
            setWaitingWorker(installing);
          }
        });
      });
    };

    // Geliştirme ortamında (localhost) eski SW önbelleklerini temizle ki
    // yapılan kod/tasarım değişiklikleri yenilemede eski sürüme dönmesin.
    if (
      typeof window !== "undefined" &&
      (window.location.hostname === "localhost" ||
        window.location.hostname === "127.0.0.1") &&
      "caches" in window
    ) {
      window.caches
        .keys()
        .then((keys) => Promise.all(keys.map((k) => window.caches.delete(k))))
        .catch(() => {});
    }

    navigator.serviceWorker
      .register("/sw.js", { scope: "/", updateViaCache: "none" })
      .then((reg) => {
        if (cancelled) return;
        registration = reg;
        if (
          window.location.hostname === "localhost" ||
          window.location.hostname === "127.0.0.1"
        ) {
          reg.update().catch(() => {});
          reg.waiting?.postMessage({ type: "SKIP_WAITING" });
        } else {
          trackUpdates(reg);
        }
      })
      .catch((err) => {
        if (process.env.NODE_ENV !== "production") {
          console.warn("[pwa] Service worker kaydedilemedi:", err);
        }
      });

    // Uygulama öne geldiğinde güncelleme var mı diye bak (çok sık değil).
    const checkOnVisible = () => {
      if (document.visibilityState === "visible") {
        registration?.update().catch(() => {});
      }
    };
    document.addEventListener("visibilitychange", checkOnVisible);

    // Yeni sürüm devreye girdiğinde sayfayı bir kez yenile.
    let refreshing = false;
    const onControllerChange = () => {
      if (refreshing) return;
      refreshing = true;
      window.location.reload();
    };
    navigator.serviceWorker.addEventListener(
      "controllerchange",
      onControllerChange,
    );

    return () => {
      cancelled = true;
      document.removeEventListener("visibilitychange", checkOnVisible);
      navigator.serviceWorker.removeEventListener(
        "controllerchange",
        onControllerChange,
      );
    };
  }, []);

  // --- Çevrimdışı durumu ---
  useEffect(() => {
    const update = () => setOffline(!navigator.onLine);
    update();
    window.addEventListener("online", update);
    window.addEventListener("offline", update);
    return () => {
      window.removeEventListener("online", update);
      window.removeEventListener("offline", update);
    };
  }, []);

  const applyUpdate = () => {
    if (!waitingWorker) return;
    setReloading(true);
    waitingWorker.postMessage({ type: "SKIP_WAITING" });
  };

  return (
    <>
      <InstallBanner />

      {/* Çevrimdışı bildirimi */}
      <div
        aria-live="polite"
        className={`pointer-events-none fixed inset-x-0 z-[70] flex justify-center px-3 transition-all duration-300 ${
          offline ? "translate-y-0 opacity-100" : "-translate-y-3 opacity-0"
        }`}
        style={{ top: "calc(env(safe-area-inset-top, 0px) + 0.5rem)" }}
      >
        {offline && (
          <div className="pointer-events-auto flex items-center gap-2 rounded-2xl border border-amber-200 bg-amber-50/95 px-3.5 py-2 text-[13px] font-semibold text-amber-900 shadow-lg backdrop-blur-xl dark:border-amber-500/30 dark:bg-amber-950/80 dark:text-amber-200">
            <span className="h-2 w-2 shrink-0 rounded-full bg-amber-500" />
            <span>{t("pwa.offline_title")}</span>
            <button
              type="button"
              onClick={() => window.location.reload()}
              className="ml-1 rounded-lg bg-amber-500/15 px-2 py-0.5 text-[12px] font-bold text-amber-900 active:scale-95 dark:text-amber-200"
            >
              {t("pwa.offline_retry")}
            </button>
          </div>
        )}
      </div>

      {/* Yeni sürüm hazır */}
      {waitingWorker && (
        <div
          className="fixed inset-x-0 z-[70] flex justify-center px-3"
          style={{ bottom: "calc(env(safe-area-inset-bottom, 0px) + 5.5rem)" }}
        >
          <div className="flex items-center gap-3 rounded-2xl border border-indigo-200 bg-white/95 px-4 py-2.5 shadow-xl backdrop-blur-xl dark:border-indigo-500/30 dark:bg-slate-900/95">
            <span className="text-[13px] font-bold text-slate-800 dark:text-slate-100">
              {t("pwa.update_ready")}
            </span>
            <button
              type="button"
              onClick={applyUpdate}
              disabled={reloading}
              className="rounded-xl bg-indigo-600 px-3 py-1 text-[12px] font-bold text-white shadow-sm transition active:scale-95 disabled:opacity-60"
            >
              {t("pwa.update_button")}
            </button>
          </div>
        </div>
      )}
    </>
  );
}
</file>

<file path="src/components/ui/ConfirmDialog.tsx">
"use client";

import { useEffect, useRef } from "react";
import { AlertTriangle, X } from "lucide-react";

/**
 * Uygulama içi onay diyaloğu.
 *
 * Neden gerekli: silme gibi geri alınamaz işlemler `window.confirm()` ile
 * soruluyordu. Mobilde tarayıcı diyaloğu tüm akışı kesiyor, tasarım diliyle
 * uyuşmuyor ve PWA'da "beyaz kutu" olarak görünüyor. Bu bileşen aynı işi
 * uygulamanın kendi tasarımıyla, klavye (Esc) desteğiyle ve yükleme durumuyla
 * yapar. Ayrıca `data-no-swipe` ile sekme kaydırma jestini engeller.
 */
interface ConfirmDialogProps {
  open: boolean;
  title: string;
  message?: string;
  confirmLabel: string;
  cancelLabel: string;
  /** Yıkıcı işlem (silme) ise kırmızı vurgu kullanılır. */
  destructive?: boolean;
  loading?: boolean;
  onConfirm: () => void;
  onCancel: () => void;
}

export default function ConfirmDialog({
  open,
  title,
  message,
  confirmLabel,
  cancelLabel,
  destructive = false,
  loading = false,
  onConfirm,
  onCancel,
}: ConfirmDialogProps) {
  const confirmRef = useRef<HTMLButtonElement>(null);

  useEffect(() => {
    if (!open) return;
    confirmRef.current?.focus();
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape" && !loading) onCancel();
    };
    document.addEventListener("keydown", onKey);
    return () => document.removeEventListener("keydown", onKey);
  }, [open, loading, onCancel]);

  if (!open) return null;

  return (
    <div
      data-no-swipe
      role="dialog"
      aria-modal="true"
      aria-label={title}
      className="fixed inset-0 z-[200] flex items-end sm:items-center justify-center p-3 sm:p-4"
    >
      <div
        className="absolute inset-0 bg-black/45 backdrop-blur-sm animate-backdrop-in"
        onClick={() => !loading && onCancel()}
      />
      <div className="relative w-full max-w-md rounded-3xl border border-white/60 bg-white p-5 shadow-2xl animate-modal-in dark:border-slate-700/60 dark:bg-slate-900">
        <div className="flex items-start gap-3">
          <span
            className={`mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl ${
              destructive
                ? "bg-red-50 text-red-600 dark:bg-red-500/15 dark:text-red-400"
                : "bg-indigo-50 text-indigo-600 dark:bg-indigo-500/15 dark:text-indigo-400"
            }`}
          >
            <AlertTriangle size={19} />
          </span>
          <div className="min-w-0 flex-1">
            <h3 className="text-[15px] font-bold leading-tight text-slate-900 dark:text-slate-100">
              {title}
            </h3>
            {message && (
              <p className="mt-1.5 text-[13px] leading-relaxed text-slate-500 dark:text-slate-400">
                {message}
              </p>
            )}
          </div>
          <button
            type="button"
            onClick={onCancel}
            disabled={loading}
            aria-label={cancelLabel}
            className="-mr-1 -mt-1 shrink-0 rounded-full p-1.5 text-slate-400 transition active:scale-90 disabled:opacity-40 dark:text-slate-500"
          >
            <X size={16} />
          </button>
        </div>

        <div className="mt-5 flex items-center gap-2.5">
          <button
            type="button"
            onClick={onCancel}
            disabled={loading}
            className="flex-1 rounded-2xl border border-slate-200 bg-white py-2.5 text-[13px] font-bold text-slate-700 transition active:scale-95 disabled:opacity-50 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-200"
          >
            {cancelLabel}
          </button>
          <button
            ref={confirmRef}
            type="button"
            onClick={onConfirm}
            disabled={loading}
            className={`flex-1 rounded-2xl py-2.5 text-[13px] font-bold text-white shadow-md transition active:scale-95 disabled:opacity-60 ${
              destructive
                ? "bg-red-600 shadow-red-500/25 hover:bg-red-500"
                : "bg-indigo-600 shadow-indigo-500/25 hover:bg-indigo-500"
            }`}
          >
            {loading ? "…" : confirmLabel}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/ui/InlineAlert.tsx">
"use client";

import type { ReactNode } from "react";
import { AlertCircle, CheckCircle2, Info, X } from "lucide-react";

/**
 * Satır içi durum mesajı (hata / başarı / bilgi).
 *
 * Neden gerekli: hata mesajları `alert()` ile gösteriliyordu. Tarayıcı
 * diyaloğu mobilde tüm akışı keser, tasarımla uyuşmaz ve kullanıcı mesajı
 * kaçırabilir. Bu bileşen mesajı sayfanın içinde, kalıcı ve erişilebilir
 * (`role="alert"`) biçimde gösterir.
 */
type AlertKind = "error" | "success" | "info";

const STYLES: Record<
  AlertKind,
  { wrap: string; icon: string; Icon: typeof AlertCircle }
> = {
  error: {
    wrap: "border-red-200 bg-red-50 text-red-700 dark:border-red-500/30 dark:bg-red-950/40 dark:text-red-300",
    icon: "text-red-600 dark:text-red-400",
    Icon: AlertCircle,
  },
  success: {
    wrap: "border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-950/40 dark:text-emerald-300",
    icon: "text-emerald-600 dark:text-emerald-400",
    Icon: CheckCircle2,
  },
  info: {
    wrap: "border-indigo-200 bg-indigo-50 text-indigo-700 dark:border-indigo-500/30 dark:bg-indigo-950/40 dark:text-indigo-300",
    icon: "text-indigo-600 dark:text-indigo-400",
    Icon: Info,
  },
};

interface InlineAlertProps {
  kind?: AlertKind;
  children: ReactNode;
  /** Verilirse sağda kapatma düğmesi gösterilir. */
  onDismiss?: () => void;
  className?: string;
}

export default function InlineAlert({
  kind = "error",
  children,
  onDismiss,
  className = "",
}: InlineAlertProps) {
  if (!children) return null;
  const { wrap, icon, Icon } = STYLES[kind];

  return (
    <div
      role="alert"
      className={`flex items-start gap-2.5 rounded-2xl border p-3.5 text-[13px] font-semibold leading-snug ${wrap} ${className}`}
    >
      <Icon size={16} className={`mt-0.5 shrink-0 ${icon}`} />
      <div className="flex-1">{children}</div>
      {onDismiss && (
        <button
          type="button"
          onClick={onDismiss}
          aria-label="Kapat"
          className="shrink-0 rounded-full px-1 opacity-70 transition active:scale-90"
        >
          <X size={14} />
        </button>
      )}
    </div>
  );
}
</file>

<file path="src/components/ImageCropper.tsx">
"use client";

import { useEffect, useRef, useState } from "react";
import { createPortal } from "react-dom";
import { Check, Loader2, Minus, Plus } from "lucide-react";
import {
  cropMetrics,
  dragPosition,
  type CropPosition,
  type Size,
} from "@/lib/crop";

interface ImageCropperProps {
  /** Kırpılacak görselin URL'si (dosya seçiminden gelen object URL) */
  src: string;
  /** Çerçevenin en/boy oranı: profil 1, kapak 2 */
  aspect: number;
  /** Dairesel çerçeve (profil fotoğrafı) */
  round?: boolean;
  /** Dışa aktarılan görselin genişliği (px) */
  outputWidth: number;
  title: string;
  /** Yükleme sürerken butonu kilitler */
  saving?: boolean;
  onCancel: () => void;
  onSave: (blob: Blob) => void;
}

const MAX_ZOOM = 3;

/**
 * Fotoğrafı çerçeveye oturtma aracı: sürükle-kaydır + yakınlaştırma.
 * Kaydet'e basınca kırpılmış görseli JPEG blob olarak döner; yükleme
 * işini çağıran taraf (Supabase Storage) yapar.
 *
 * `ponytail:` iki parmakla zoom yok; mobilde zoom kaydırıcıdan yapılır.
 */
export default function ImageCropper({
  src,
  aspect,
  round = false,
  outputWidth,
  title,
  saving = false,
  onCancel,
  onSave,
}: ImageCropperProps) {
  const imageRef = useRef<HTMLImageElement | null>(null);
  const frameRef = useRef<HTMLDivElement | null>(null);
  const dragRef = useRef<{
    startX: number;
    startY: number;
    start: CropPosition;
  } | null>(null);

  const [natural, setNatural] = useState<Size | null>(null);
  const [viewport, setViewport] = useState<Size | null>(null);
  const [zoom, setZoom] = useState(1);
  const [position, setPosition] = useState<CropPosition>({ x: 0, y: 0 });

  // Görseli önceden yükle: hem çerçeve ölçüsü hem canvas için tek bitmap kullanılır.
  useEffect(() => {
    const image = new window.Image();
    image.onload = () => {
      imageRef.current = image;
      setNatural({ width: image.naturalWidth, height: image.naturalHeight });
    };
    image.src = src;
    return () => {
      image.onload = null;
    };
  }, [src]);

  // Çerçeve ölçüsü (responsive): kırpma oranı kaydırma oranı olarak tutulduğu
  // için pencere boyutu değişse de görsel aynı yerde kalır.
  useEffect(() => {
    const measure = () => {
      const el = frameRef.current;
      if (!el) return;
      const rect = el.getBoundingClientRect();
      setViewport({ width: rect.width, height: rect.height });
    };
    measure();
    window.addEventListener("resize", measure);
    return () => window.removeEventListener("resize", measure);
  }, []);

  useEffect(() => {
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") onCancel();
    };
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [onCancel]);

  const metrics =
    natural && viewport
      ? cropMetrics({ natural, viewport, zoom, position })
      : null;

  const handlePointerDown = (event: React.PointerEvent<HTMLDivElement>) => {
    if (!metrics) return;
    event.currentTarget.setPointerCapture(event.pointerId);
    dragRef.current = {
      startX: event.clientX,
      startY: event.clientY,
      start: position,
    };
  };

  const handlePointerMove = (event: React.PointerEvent<HTMLDivElement>) => {
    const drag = dragRef.current;
    if (!drag || !metrics) return;
    setPosition(
      dragPosition(
        drag.start,
        { x: event.clientX - drag.startX, y: event.clientY - drag.startY },
        metrics.maxOffset,
      ),
    );
  };

  const handlePointerUp = () => {
    dragRef.current = null;
  };

  const handleSave = () => {
    const image = imageRef.current;
    if (!image || !natural || !viewport) return;

    const canvas = document.createElement("canvas");
    canvas.width = Math.round(outputWidth);
    canvas.height = Math.max(
      1,
      Math.round((outputWidth * viewport.height) / viewport.width),
    );
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const { rect } = cropMetrics({ natural, viewport, zoom, position });
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
    ctx.drawImage(
      image,
      rect.sx,
      rect.sy,
      rect.sw,
      rect.sh,
      0,
      0,
      canvas.width,
      canvas.height,
    );

    canvas.toBlob(
      (blob) => {
        if (blob) onSave(blob);
      },
      "image/jpeg",
      0.9,
    );
  };

  const ready = Boolean(metrics);

  // Panel kartları `backdrop-blur` kullandığı için `fixed` onların içinde
  // kapsanır; pencereyi body'ye taşıyoruz (PostModal ile aynı desen).
  if (typeof document === "undefined") return null;

  return createPortal(
    <div
      role="dialog"
      aria-modal="true"
      aria-label={title}
      className="animate-backdrop-in fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 p-4 backdrop-blur-sm"
    >
      <div className="animate-modal-in w-full max-w-[460px] rounded-[28px] border border-white/60 bg-white p-5 shadow-2xl dark:border-slate-700 dark:bg-slate-900">
        <h3 className="text-base font-bold text-slate-900 dark:text-white">
          {title}
        </h3>
        <p className="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">
          Fotoğrafı sürükleyerek konumlandırın, kaydırıcı ile yakınlaştırın.
        </p>

        <div
          ref={frameRef}
          onPointerDown={handlePointerDown}
          onPointerMove={handlePointerMove}
          onPointerUp={handlePointerUp}
          onPointerCancel={handlePointerUp}
          style={{ aspectRatio: String(aspect) }}
          className={`relative mt-4 w-full cursor-grab touch-none overflow-hidden bg-slate-900/90 active:cursor-grabbing ${
            round
              ? "mx-auto max-w-[240px] rounded-full ring-2 ring-white/60"
              : "rounded-2xl"
          }`}
        >
          {metrics ? (
            // eslint-disable-next-line @next/next/no-img-element
            <img
              src={src}
              alt=""
              draggable={false}
              className="pointer-events-none absolute top-1/2 left-1/2 max-w-none select-none"
              style={{
                width: metrics.drawn.width,
                height: metrics.drawn.height,
                transform: `translate(-50%, -50%) translate(${metrics.offset.x}px, ${metrics.offset.y}px)`,
              }}
            />
          ) : (
            <div className="absolute inset-0 flex items-center justify-center text-slate-300">
              <Loader2 size={22} className="animate-spin" />
            </div>
          )}
        </div>

        <div className="mt-4 flex items-center gap-3">
          <button
            type="button"
            onClick={() =>
              setZoom((z) => Math.max(1, Number((z - 0.2).toFixed(2))))
            }
            disabled={zoom <= 1}
            aria-label="Uzaklaştır"
            className="rounded-xl bg-slate-100 p-2 text-slate-600 transition-colors hover:bg-slate-200 disabled:opacity-40 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
          >
            <Minus size={16} />
          </button>
          <input
            type="range"
            min={1}
            max={MAX_ZOOM}
            step={0.01}
            value={zoom}
            onChange={(event) => setZoom(Number(event.target.value))}
            aria-label="Yakınlaştır"
            className="h-1.5 flex-1 cursor-pointer appearance-none rounded-full bg-slate-200 accent-indigo-600 dark:bg-slate-700"
          />
          <button
            type="button"
            onClick={() =>
              setZoom((z) => Math.min(MAX_ZOOM, Number((z + 0.2).toFixed(2))))
            }
            disabled={zoom >= MAX_ZOOM}
            aria-label="Yakınlaştır"
            className="rounded-xl bg-slate-100 p-2 text-slate-600 transition-colors hover:bg-slate-200 disabled:opacity-40 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
          >
            <Plus size={16} />
          </button>
        </div>

        <div className="mt-5 flex items-center justify-end gap-2">
          <button
            type="button"
            onClick={onCancel}
            disabled={saving}
            className="rounded-2xl px-4 py-2.5 text-sm font-bold text-slate-500 transition-colors hover:bg-slate-100 disabled:opacity-50 dark:text-slate-400 dark:hover:bg-slate-800"
          >
            İptal
          </button>
          <button
            type="button"
            onClick={handleSave}
            disabled={!ready || saving}
            className="inline-flex items-center gap-2 rounded-2xl bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-indigo-500/30 transition-all hover:bg-indigo-500 active:scale-95 disabled:opacity-50"
          >
            {saving ? (
              <Loader2 size={16} className="animate-spin" />
            ) : (
              <Check size={16} />
            )}
            {saving ? "Yükleniyor..." : "Kaydet"}
          </button>
        </div>
      </div>
    </div>,
    document.body,
  );
}
