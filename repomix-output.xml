  lime: "Lime",
  yellow: "Sarı",
  amber: "Amber",
  orange: "Turuncu",
  red: "Kırmızı",
  rose: "Gül",
  pink: "Pembe",
  fuchsia: "Fuşya",
  purple: "Mor",
  violet: "Menekşe",
  slate: "Slate",
  gray: "Gri",
  zinc: "Zinc",
  neutral: "Nötr",
  stone: "Taş",
};

// Sarı/amber/lime gibi açık renklerde beyaz metin okunmaz: ana rengi bir kademe koyulaştır.
const DARKEN_BRAND = new Set(["yellow", "amber", "lime"]);

function roles(color: string, mode: "light" | "dark"): PaletteRoles {
  const scale = SCALES[color];
  const base = DARKEN_BRAND.has(color) ? 700 : 600;

  return mode === "light"
    ? {
        brand: scale[base],
        brandStrong: scale[base + 100],
        brandSoft: scale[50],
        brandSoftHover: scale[100],
        brandText: scale[700],
        brandBorder: scale[200],
      }
    : {
        brand: scale[DARKEN_BRAND.has(color) ? 600 : 500],
        brandStrong: scale[DARKEN_BRAND.has(color) ? 500 : 400],
        brandSoft: scale[950],
        brandSoftHover: scale[900],
        brandText: scale[300],
        brandBorder: scale[800],
      };
}

const PALETTE_ORDER = [
  "indigo",
  "blue",
  "sky",
  "cyan",
  "teal",
  "emerald",
  "green",
  "lime",
  "yellow",
  "amber",
  "orange",
  "red",
  "rose",
  "pink",
  "fuchsia",
  "purple",
  "violet",
  "slate",
  "gray",
  "zinc",
  "neutral",
  "stone",
];

export const PALETTES: Palette[] = PALETTE_ORDER.map((id) => ({
  id,
  name: NAMES[id],
  light: roles(id, "light"),
  dark: roles(id, "dark"),
}));

export const DEFAULT_PALETTE_ID = "indigo";

export function getPalette(id: string | null | undefined): Palette {
  return PALETTES.find((p) => p.id === id) ?? PALETTES[0];
}

function vars(r: PaletteRoles) {
  return [
    `--brand:${r.brand}`,
    `--brand-strong:${r.brandStrong}`,
    `--brand-soft:${r.brandSoft}`,
    `--brand-soft-hover:${r.brandSoftHover}`,
    `--brand-text:${r.brandText}`,
    `--brand-border:${r.brandBorder}`,
    "--brand-shadow:color-mix(in srgb, var(--brand) 30%, transparent)",
  ].join(";");
}

/**
 * Palet değişkenlerini `.brand-scope` altında tanımlar.
 * `force-light` / `force-dark` sınıfları ayarlardaki önizleme içindir.
 */
export function paletteCss(palette: Palette): string {
  return [
    `.brand-scope{${vars(palette.light)}}`,
    `.dark .brand-scope,.brand-scope.dark{${vars(palette.dark)}}`,
    `.brand-scope.force-light{${vars(palette.light)}}`,
    `.brand-scope.force-dark{${vars(palette.dark)}}`,
  ].join("");
}
