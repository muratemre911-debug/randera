                    className={INPUT}
                  />
                  <button
                    type="submit"
                    disabled={notifLoading}
                    className={`${BTN_PRIMARY} w-full`}
                  >
                    {notifLoading ? (
                      <Loader2 size={16} className="animate-spin" />
                    ) : (
                      <Send size={16} />
                    )}
