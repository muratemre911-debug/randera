"use client";

import React, {
  useState,
  useRef,
  useEffect,
  useMemo,
  useCallback,
} from "react";
import { createPortal } from "react-dom";
import { ChevronDown, Check, Search, X } from "lucide-react";

export interface CustomSelectOption {
  value: string | number;
  label: string;
  badge?: string;
  sublabel?: string;
  disabled?: boolean;
}

export type SelectOption = string | number | CustomSelectOption;

export interface CustomSelectProps {
  value?: string | number | null;
  onChange: (value: any) => void;
  options: SelectOption[];
  placeholder?: string;
  disabled?: boolean;
  className?: string;
  buttonClassName?: string;
  menuClassName?: string;
  searchable?: boolean;
  searchPlaceholder?: string;
  emptyText?: string;
  id?: string;
  name?: string;
}

export default function CustomSelect({
  value,
  onChange,
  options,
  placeholder = "Seçiniz...",
  disabled = false,
  className = "",
  buttonClassName = "",
  menuClassName = "",
  searchable,
  searchPlaceholder = "Ara...",
  emptyText = "Sonuç bulunamadı",
  id,
  name,
}: CustomSelectProps) {
  const [isOpen, setIsOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [mounted, setMounted] = useState(false);
  const [coords, setCoords] = useState<{
    top: number;
    left: number;
    width: number;
    placeAbove: boolean;
  } | null>(null);

  const containerRef = useRef<HTMLDivElement>(null);
  const menuRef = useRef<HTMLDivElement>(null);
  const searchInputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    setMounted(true);
  }, []);

  // Normalize options to object format
  const normalizedOptions: CustomSelectOption[] = useMemo(() => {
    return options.map((opt) => {
      if (typeof opt === "string" || typeof opt === "number") {
        return { value: opt, label: String(opt) };
      }
      return opt;
    });
  }, [options]);

  // Determine if search should be enabled (auto-enable if > 7 options)
  const isSearchEnabled = searchable ?? normalizedOptions.length > 7;

  // Filter options based on search query
  const filteredOptions = useMemo(() => {
    if (!searchQuery.trim()) return normalizedOptions;
    const q = searchQuery.toLowerCase().trim();
    return normalizedOptions.filter(
      (opt) =>
        opt.label.toLowerCase().includes(q) ||
        (opt.sublabel && opt.sublabel.toLowerCase().includes(q)) ||
        (opt.badge && opt.badge.toLowerCase().includes(q)),
    );
  }, [normalizedOptions, searchQuery]);

  // Find currently selected option
  const selectedOption = useMemo(() => {
    if (value === undefined || value === null || value === "") return null;
    return (
      normalizedOptions.find((opt) => String(opt.value) === String(value)) ||
      null
    );
  }, [normalizedOptions, value]);

  // Calculate coordinates for portal floating placement
  const updateCoords = useCallback(() => {
    if (!containerRef.current) return;
    const rect = containerRef.current.getBoundingClientRect();

    // If completely off-screen, close
    if (rect.bottom < 0 || rect.top > window.innerHeight) {
      setIsOpen(false);
      return;
    }

    const spaceBelow = window.innerHeight - rect.bottom;
    const spaceAbove = rect.top;
    const estimatedHeight = 280;
    const placeAbove = spaceBelow < estimatedHeight && spaceAbove > spaceBelow;

    const padding = 8;
    let width = rect.width;
    let left = rect.left;

    if (left + width > window.innerWidth - padding) {
      width = Math.min(width, window.innerWidth - padding * 2);
      left = Math.max(padding, window.innerWidth - width - padding);
    }
    if (left < padding) {
      left = padding;
      width = Math.min(width, window.innerWidth - padding * 2);
    }

    setCoords({
      top: placeAbove ? rect.top - 6 : rect.bottom + 6,
      left,
      width,
      placeAbove,
    });
  }, []);

  const toggleOpen = () => {
    if (disabled) return;
    if (!isOpen) {
      updateCoords();
      setIsOpen(true);
    } else {
      setIsOpen(false);
    }
  };

  // Keep dropdown repositioned on window scroll or resize
  useEffect(() => {
    if (isOpen) {
      updateCoords();
      const handleScroll = () => updateCoords();
      const handleResize = () => updateCoords();

      window.addEventListener("scroll", handleScroll, true);
      window.addEventListener("resize", handleResize);

      return () => {
        window.removeEventListener("scroll", handleScroll, true);
        window.removeEventListener("resize", handleResize);
      };
    }
  }, [isOpen, updateCoords]);

  // Click outside and escape key handling
  useEffect(() => {
    if (!isOpen) return;

    const handlePointerDown = (e: MouseEvent | TouchEvent) => {
      const target = e.target as Node;
      if (
        containerRef.current &&
        !containerRef.current.contains(target) &&
        menuRef.current &&
        !menuRef.current.contains(target)
      ) {
        setIsOpen(false);
      }
    };

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        setIsOpen(false);
      }
    };

    document.addEventListener("pointerdown", handlePointerDown);
    document.addEventListener("keydown", handleKeyDown);

    return () => {
      document.removeEventListener("pointerdown", handlePointerDown);
      document.removeEventListener("keydown", handleKeyDown);
    };
  }, [isOpen]);

  // Focus search input on open
  useEffect(() => {
    if (isOpen && isSearchEnabled) {
      setTimeout(() => {
        searchInputRef.current?.focus({ preventScroll: true });
      }, 50);
    } else {
      setSearchQuery("");
    }
  }, [isOpen, isSearchEnabled]);

  const handleSelect = (option: CustomSelectOption) => {
    if (option.disabled) return;
    onChange(option.value);
    setIsOpen(false);
    setSearchQuery("");
  };

  return (
    <div ref={containerRef} className={`relative ${className}`}>
      {/* Hidden input for form integration */}
      {name && (
        <input
          type="hidden"
          name={name}
          id={id}
          value={value !== undefined && value !== null ? String(value) : ""}
        />
      )}

      {/* Select Button */}
      <button
        type="button"
        disabled={disabled}
        onClick={toggleOpen}
        className={
          buttonClassName ||
          `w-full flex items-center justify-between rounded-2xl border bg-slate-50/80 px-4 py-3 text-[15px] font-medium text-slate-900 transition-all hover:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 dark:bg-slate-800/60 dark:text-white dark:hover:border-slate-600 dark:focus:bg-slate-800 dark:focus:border-indigo-500 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none select-none ${
            isOpen
              ? "border-indigo-500 ring-2 ring-indigo-500/20 bg-white dark:bg-slate-800 dark:border-indigo-500"
              : "border-slate-200 dark:border-slate-700"
          }`
        }
      >
        <div className="flex items-center gap-2 truncate mr-2 min-w-0">
          <span
            className={`truncate ${
              !selectedOption
                ? "text-slate-400 dark:text-slate-400 font-normal"
                : "text-slate-900 dark:text-white font-medium"
            }`}
          >
            {selectedOption ? selectedOption.label : placeholder}
          </span>
          {selectedOption?.badge && (
            <span className="text-xs px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 font-bold shrink-0 border border-indigo-100/80 dark:border-indigo-900/40">
              {selectedOption.badge}
            </span>
          )}
          {selectedOption?.sublabel && (
            <span className="text-xs text-slate-400 dark:text-slate-400 shrink-0 font-normal">
              ({selectedOption.sublabel})
            </span>
          )}
        </div>

        <ChevronDown
          size={16}
          className={`text-slate-400 shrink-0 transition-transform duration-200 ${
            isOpen ? "rotate-180" : ""
          }`}
        />
      </button>

      {/* Dropdown Menu via Portal into document.body to escape any parent stacking contexts */}
      {mounted &&
        isOpen &&
        coords &&
        typeof document !== "undefined" &&
        createPortal(
          <div
            ref={menuRef}
            style={{
              position: "fixed",
              top: `${coords.top}px`,
              left: `${coords.left}px`,
              width: `${coords.width}px`,
              transform: coords.placeAbove ? "translateY(-100%)" : "none",
              zIndex: 999999,
            }}
            className={
              menuClassName ||
              `max-h-64 overflow-y-auto overflow-x-hidden rounded-2xl border border-slate-200/90 bg-white/95 p-1.5 shadow-2xl backdrop-blur-3xl dark:border-slate-700/80 dark:bg-slate-900/95 font-sans custom-scrollbar animate-in fade-in zoom-in-95 duration-150 select-none`
            }
          >
            {/* Search Header */}
            {isSearchEnabled && (
              <div className="sticky top-0 z-10 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md pb-1.5 mb-1 border-b border-slate-100 dark:border-slate-800/80 px-1 pt-0.5">
                <div className="relative flex items-center">
                  <Search
                    size={14}
                    className="absolute left-2.5 text-slate-400 pointer-events-none"
                  />
                  <input
                    ref={searchInputRef}
                    type="text"
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    placeholder={searchPlaceholder}
                    className="w-full pl-8 pr-7 py-1.5 text-xs rounded-xl bg-slate-100/80 dark:bg-slate-800 border border-transparent focus:border-indigo-400 focus:bg-white dark:focus:bg-slate-800/90 outline-none text-slate-800 dark:text-slate-200 placeholder:text-slate-400 transition-colors"
                    onClick={(e) => e.stopPropagation()}
                  />
                  {searchQuery && (
                    <button
                      type="button"
                      onClick={() => setSearchQuery("")}
                      className="absolute right-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5"
                    >
                      <X size={12} />
                    </button>
                  )}
                </div>
              </div>
            )}

            {/* Options List */}
            <div className="space-y-0.5">
              {filteredOptions.length === 0 ? (
                <div className="py-4 text-center text-xs text-slate-400 dark:text-slate-500">
                  {emptyText}
                </div>
              ) : (
                filteredOptions.map((opt) => {
                  const isSelected =
                    selectedOption &&
                    String(selectedOption.value) === String(opt.value);

                  return (
                    <button
                      key={String(opt.value)}
                      type="button"
                      disabled={opt.disabled}
                      onClick={() => handleSelect(opt)}
                      className={`w-full text-left px-3 py-2 text-sm rounded-xl cursor-pointer transition-colors flex items-center justify-between gap-2 ${
                        opt.disabled
                          ? "opacity-40 cursor-not-allowed"
                          : isSelected
                            ? "bg-indigo-50 text-indigo-700 font-medium dark:bg-indigo-950/60 dark:text-indigo-300"
                            : "text-slate-700 dark:text-slate-200 hover:bg-slate-100/80 dark:hover:bg-slate-800/80"
                      }`}
                    >
                      <div className="flex flex-col truncate">
                        <span className="truncate">{opt.label}</span>
                        {opt.sublabel && (
                          <span className="text-[11px] text-slate-400 dark:text-slate-500 truncate">
                            {opt.sublabel}
                          </span>
                        )}
                      </div>

                      <div className="flex items-center gap-2 shrink-0">
                        {opt.badge && (
                          <span className="text-xs px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                            {opt.badge}
                          </span>
                        )}
                        {isSelected && (
                          <Check
                            size={15}
                            className="text-indigo-600 dark:text-indigo-400 shrink-0"
                          />
                        )}
                      </div>
                    </button>
                  );
                })
              )}
            </div>
          </div>,
          document.body,
        )}
    </div>
  );
}
</file>

<file path="src/components/PostGrid.tsx">
"use client";

import React from "react";
import { Star, Trash2, Heart, MessageCircle } from "lucide-react";
import { Post } from "@/types";
import { formatNumber } from "@/lib/utils";

interface PostGridProps {
  posts: Post[];
  onPostClick: (post: Post) => void;
  onDelete?: (postId: string) => void;
  onToggleFeature?: (postId: string) => void;
  featuredPostIds?: string[];
  columns?: 3 | 4;
  isLoading?: boolean;
}

export function PostGrid({
  posts,
  onPostClick,
  onDelete,
  onToggleFeature,
  featuredPostIds = [],
  columns = 3,
  isLoading = false,
}: PostGridProps) {
  if (isLoading) {
    return (
      <div
        className={
          columns === 4
            ? "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 md:gap-3"
            : "grid grid-cols-2 sm:grid-cols-3 gap-2 md:gap-3"
        }
        role="status"
        aria-label="Gönderiler yükleniyor"
      >
        {Array.from({ length: 9 }).map((_, i) => (
          <div key={i} className="aspect-square bg-slate-200 dark:bg-slate-700 animate-pulse rounded-2xl" />
        ))}
      </div>
    );
  }

  if (posts.length === 0) {
    return (
      <div className="py-16 text-center text-gray-500 dark:text-slate-400">
        <div className="flex flex-col items-center gap-3">
          <div className="h-16 w-16 rounded-3xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
            <svg className="h-8 w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <p className="text-sm font-semibold text-slate-800 dark:text-white">Henüz gönderi yok</p>
          <p className="text-xs text-slate-400">İşletmenizin fotoğraflarını yükleyerek vitrininizi oluşturun.</p>
        </div>
      </div>
    );
  }

  const gridClass =
    columns === 4
      ? "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 md:gap-3.5"
      : "grid grid-cols-2 sm:grid-cols-3 gap-2.5 md:gap-3.5";

  return (
    <div className={gridClass} role="list" aria-label="İşletme gönderileri">
      {posts.map((post) => (
        <PostGridItem
          key={post.id}
          post={post}
          onClick={onPostClick}
          onDelete={onDelete}
          onToggleFeature={onToggleFeature}
          isFeatured={featuredPostIds.includes(post.id)}
        />
      ))}
    </div>
  );
}

interface PostGridItemProps {
  post: Post;
  onClick: (post: Post) => void;
  onDelete?: (postId: string) => void;
  onToggleFeature?: (postId: string) => void;
  isFeatured?: boolean;
}

function PostGridItem({ post, onClick, onDelete, onToggleFeature, isFeatured = false }: PostGridItemProps) {
  const [imageError, setImageError] = React.useState(false);

  const handleClick = () => onClick(post);
  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      onClick(post);
    }
  };

  const likeCount = post.like_count || 0;
  const commentCount = post.comment_count || 0;

  return (
    <article
      className="relative aspect-square overflow-hidden bg-slate-100 dark:bg-slate-800 cursor-pointer group rounded-2xl border border-slate-200/60 dark:border-slate-700/60 shadow-xs"
      role="listitem"
      tabIndex={0}
      onClick={handleClick}
      onKeyDown={handleKeyDown}
      aria-label={`Gönderi: ${post.description?.slice(0, 100) || "Açıklama yok"} - ${formatNumber(likeCount)} beğeni, ${formatNumber(commentCount)} yorum`}
    >
      {imageError ? (
        <div className="w-full h-full flex items-center justify-center bg-slate-200 dark:bg-slate-700">
          <svg className="h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      ) : (
        <img
          src={post.image_url}
          alt={post.description || "İşletme gönderisi"}
          className="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          onError={() => setImageError(true)}
          loading="lazy"
        />
      )}

      {isFeatured && (
        <div className="absolute top-2 left-2 z-10 flex items-center gap-1 rounded-lg bg-amber-500/90 px-2 py-0.5 text-[10px] font-bold text-white shadow-xs backdrop-blur-xs">
          <Star size={11} className="fill-white" />
          <span>Öne Çıkan</span>
        </div>
      )}

      {(onDelete || onToggleFeature) && (
        <div className="absolute top-2 right-2 flex items-center gap-1.5 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          {onToggleFeature && (
            <button
              type="button"
              title={isFeatured ? "Öne çıkarmayı kaldır" : "Öne çıkar"}
              onClick={(e) => {
                e.stopPropagation();
                onToggleFeature(post.id);
              }}
              className={`p-2 rounded-xl backdrop-blur-md shadow-md transition-all active:scale-90 ${
                isFeatured
                  ? "bg-amber-500 text-white"
                  : "bg-white/90 text-slate-700 hover:bg-amber-500 hover:text-white dark:bg-slate-900/90 dark:text-slate-200"
              }`}
            >
              <Star size={14} className={isFeatured ? "fill-white" : ""} />
            </button>
          )}
          {onDelete && (
            <button
              type="button"
              title="Sil"
              onClick={(e) => {
                e.stopPropagation();
                onDelete(post.id);
              }}
              className="p-2 rounded-xl bg-white/90 text-rose-600 hover:bg-rose-600 hover:text-white dark:bg-slate-900/90 dark:text-rose-400 dark:hover:bg-rose-600 dark:hover:text-white shadow-md transition-all active:scale-90"
            >
              <Trash2 size={14} />
            </button>
          )}
        </div>
      )}

      <div
        className="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-200 group-hover:opacity-100 flex items-center justify-center gap-5 text-white font-semibold text-sm pointer-events-none"
        aria-hidden="true"
      >
        <div className="flex items-center gap-1.5 drop-shadow">
          <Heart size={18} className={post.user_has_liked ? "fill-red-500 text-red-500" : "fill-white text-white"} />
          <span>{formatNumber(likeCount)}</span>
        </div>
        <div className="flex items-center gap-1.5 drop-shadow">
          <MessageCircle size={18} className="fill-white text-white" />
          <span>{formatNumber(commentCount)}</span>
        </div>
      </div>
    </article>
  );
}

const posts = [1, 2, 3, 4, 5, 6, 7, 8, 9];

export function PostGridSkeleton() {
  return (
    <div className="grid grid-cols-3 gap-1 md:gap-4" role="status" aria-label="Gönderiler yükleniyor">
      {posts.map((_, i) => (
        <div key={i} className="aspect-square bg-slate-200 dark:bg-slate-700 animate-pulse rounded-xl md:rounded-2xl" />
      ))}
    </div>
  );
}
</file>

