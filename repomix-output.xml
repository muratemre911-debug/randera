import { z } from "zod";

export const createTenantSchema = z.object({
  tenantName: z.string().min(2, "İşletme adı en az 2 karakter olmalı").max(100),
  fullName: z.string().min(2, "Ad soyad en az 2 karakter olmalı").max(100),
