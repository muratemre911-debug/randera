     <div className="flex items-center justify-between px-4 py-3.5">
      <div className="flex flex-col">
       <span className="text-[17px] text-gray-900 dark:text-white">
        SMS Bildirimi
       </span>
       <span className="text-[13px] text-gray-500 dark:text-slate-400">
        Hatırlatma SMS&apos;i gönderimi (Premium)
       </span>
      </div>
      <ToggleSwitch
       checked={rules.notifySms}
       onChange={() => onChange({ notifySms: !rules.notifySms })}
      />
     </div>

     <div className="flex items-center justify-between px-4 py-3.5">
      <div className="flex flex-col">
       <span className="text-[17px] text-gray-900 dark:text-white">
        WhatsApp
       </span>
       <span className="text-[13px] text-gray-500 dark:text-slate-400">
        WhatsApp&apos;tan randevu onayı (Premium)
       </span>
      </div>
      <ToggleSwitch
       checked={rules.notifyWhatsapp}
       onChange={() => onChange({ notifyWhatsapp: !rules.notifyWhatsapp })}
      />
     </div>
    </div>
   </div>
  </>
 );
}

function normalizeWorkingHours(hours: WorkingHours): WorkingHours {
  return Object.fromEntries(
    Object.entries(hours).map(([day, h]) => [
      day,
      h.isOpen && h.openTime === "00:00" && h.closeTime === "00:00"
        ? { isOpen: true, openTime: "09:00", closeTime: "18:00" }
        : h,
    ]),
  );
}

export default function AyarlarPage() {
  const supabase = createClient();
  const { t, lang } = useLanguage();
  const daysTranslation = lang === "tr" ? daysTranslationTR : daysTranslationEN;
  const [activeTab, setActiveTab] = useState<
    "profile" | "hours" | "booking" | "vitrin"
  >("profile");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [toast, setToast] = useState<{
    type: "success" | "error";
    message: string;
  } | null>(null);

  // Form states
  const [profile, setProfile] = useState({
    name: "",
    phone: "",
    email: "",
    address: "",
    description: "",
  });
  const [workingHours, setWorkingHours] =
    useState<WorkingHours>(defaultWorkingHours);
  const [bookingRules, setBookingRules] =
    useState<BookingRules>(defaultBookingRules);
  const [tenantId, setTenantId] = useState<string | null>(null);
  /** Oturum sahibinin rolü: staff ise işletme ayarları yerine yalnızca kendi
   *  aktif saatleri yönetilir (işletme ayarları sahibin yetkisindedir). */
  const [role, setRole] = useState<string | null>(null);
  const [userId, setUserId] = useState<string | null>(null);

  // Vitrin / Konum states
  const [province, setProvince] = useState("");
  const [district, setDistrict] = useState("");
  const [neighborhood, setNeighborhood] = useState("");
  const [street, setStreet] = useState("");
  const [buildingNo, setBuildingNo] = useState("");
  const [coords, setCoords] = useState<{ lat: number; lng: number } | null>(
    null,
  );
  const [neighborhoods, setNeighborhoods] = useState<string[]>([]);
  const [geoLoading, setGeoLoading] = useState(false);
  // İşletme sayfası tema paleti + önizleme varyantı
  const [themePalette, setThemePalette] = useState("indigo");
  const [previewDark, setPreviewDark] = useState(false);
  const [profileImageUrl, setProfileImageUrl] = useState("");
  const [coverImageUrl, setCoverImageUrl] = useState("");
  /** Kırpma penceresi açıkken seçilen dosyanın object URL'i */
  const [cropping, setCropping] = useState<{
    kind: "profile" | "cover";
    src: string;
  } | null>(null);
  const [mediaSaving, setMediaSaving] = useState<"profile" | "cover" | null>(
    null,
  );
  const [sector, setSector] = useState("");
  const [sectorsList, setSectorsList] = useState<
    { name: string; value: string }[]
  >([]);

  // Load settings
  useEffect(() => {
    const fetchSettings = async () => {
      try {
        const {
          data: { user },
        } = await supabase.auth.getUser();
        if (!user) return;
        const { data: profileData } = await supabase
          .from("profiles")
          .select("tenant_id, role")
          .eq("id", user.id)
          .single();
        const currentTenantId = profileData?.tenant_id;
        setRole(profileData?.role ?? null);
        setUserId(user.id);
        if (!currentTenantId) {
          setLoading(false);
          return;
        }
        setTenantId(currentTenantId);

        // ELEMAN: işletme ayarlarını göremez ve değiştiremez. Yalnızca kendi
        // çalışma saatlerini ve kendi randevu kurallarını yükler; işletme
        // satırından sadece varsayılan (başlangıç) değerleri okur.
        if (profileData?.role !== "owner") {
          const { data: tenantDefaults } = await supabase
            .from("tenants")
            .select("working_hours, booking_rules")
            .eq("id", currentTenantId)
            .maybeSingle();

          // Başlangıç noktası işletmenin değerleridir; eleman üzerinde
          // oynayarak kendi ayarını oluşturur.
          if (tenantDefaults?.working_hours) {
            setWorkingHours(tenantDefaults.working_hours);
          }
          if (tenantDefaults?.booking_rules) {
            setBookingRules({
              ...defaultBookingRules,
              ...tenantDefaults.booking_rules,
            });
          }

          // Elemanın kayıtlı ayarları varsa onlar önceliklidir.
          // (Tablo henüz migrate edilmemişse sorgu hata verir; sessizce
          // geçilir, kaydetme denemesinde hata gösterilir.)
          const { data: mySettings } = await supabase
            .from("staff_settings")
            .select("working_hours, booking_rules")
            .eq("profile_id", user.id)
            .maybeSingle();
          if (mySettings?.working_hours) {
            setWorkingHours(mySettings.working_hours);
          }
          if (mySettings?.booking_rules) {
            setBookingRules({
              ...defaultBookingRules,
              ...mySettings.booking_rules,
            });
          }
          return;
        }

        const localProfile = localStorage.getItem(
          `tenant_profile_${currentTenantId}`,
        );
        const localHours = localStorage.getItem(
          `tenant_hours_${currentTenantId}`,
        );
        const localRules = localStorage.getItem(
          `tenant_rules_${currentTenantId}`,
        );

        if (localProfile) setProfile(JSON.parse(localProfile));
        if (localHours) setWorkingHours(JSON.parse(localHours));
        if (localRules) setBookingRules(JSON.parse(localRules));

        const { data, error } = await supabase
          .from("tenants")
          .select(
            "name, phone, email, address, description, province, district, neighborhood, street, building_no, latitude, longitude, theme_palette, profile_image_url, cover_image_url, sector, working_hours, booking_rules",
          )
          .eq("id", currentTenantId)
          // 0 satır (silinmiş işletme / RLS) hata değildir.
          .maybeSingle();

        // Konum kolonları henüz eklenmemişse (migration) eski kolonlarla devam et
        const locationData = error
          ? (
              await supabase
                .from("tenants")
                .select(
                  "name, phone, email, address, description, province, district, profile_image_url, cover_image_url, sector, working_hours, booking_rules",
                )
                .eq("id", currentTenantId)
                .maybeSingle()
            ).data
          : data;

        const sectorRes = await fetch("/api/admin/sectors");
        const sectorData = await sectorRes.json();

        if (Array.isArray(sectorData)) {
          setSectorsList(sectorData);
        }

        const t = locationData as
          | (typeof data & {
              neighborhood?: string | null;
              street?: string | null;
              building_no?: string | null;
              latitude?: number | null;
              longitude?: number | null;
              theme_palette?: string | null;
            })
          | null;

        if (t) {
          setProfile((prev) => ({
            ...prev,
            name: t.name || "",
            phone: t.phone || "",
            email: t.email || "",
            address: t.address || "",
            description: t.description || "",
          }));
          setProvince(t.province || "");
          setDistrict(t.district || "");
          setNeighborhood(t.neighborhood || "");
          setStreet(t.street || "");
          setBuildingNo(t.building_no || "");
          setCoords(
            t.latitude != null && t.longitude != null
              ? { lat: t.latitude, lng: t.longitude }
              : null,
          );
          setProfileImageUrl(t.profile_image_url || "");
          setCoverImageUrl(t.cover_image_url || "");
          setSector(t.sector || "");
          setThemePalette(t.theme_palette || "indigo");

          if (t.working_hours) {
            setWorkingHours(t.working_hours);
          }
          if (t.booking_rules) {
            setBookingRules({ ...defaultBookingRules, ...t.booking_rules });
          }

          localStorage.setItem(
            `tenant_profile_${currentTenantId}`,
            JSON.stringify({
              ...profile,
              name: t.name || "",
              phone: t.phone || "",
              email: t.email || "",
              address: t.address || "",
              description: t.description || "",
            }),
          );
        }
      } catch (err) {
        console.error("Error loading settings:", err);
      } finally {
        setLoading(false);
      }
    };

    fetchSettings();
  }, []);

  const showToast = (type: "success" | "error", message: string) => {
    setToast({ type, message });
    setTimeout(() => setToast(null), 4000);
  };

  // --- Vitrin görselleri: dosya seç -> kırp/ölçekle -> Supabase Storage'a yükle ---

  const closeCropper = () => {
    setCropping((prev) => {
      if (prev) URL.revokeObjectURL(prev.src);
      return null;
    });
  };

  const handlePickImage = (
    kind: "profile" | "cover",
    file: File | undefined,
  ) => {
    if (!file) return;
    setCropping({ kind, src: URL.createObjectURL(file) });
  };

  const handleCropSave = async (blob: Blob) => {
    if (!cropping || !tenantId) return;
    const kind = cropping.kind;
    setMediaSaving(kind);

    try {
      // Zaman damgalı yol: tarayıcı/CDN önbelleği eski fotoğrafı göstermesin.
      const path = `${tenantId}/${kind}-${Date.now()}.jpg`;
      const { error } = await supabase.storage
        .from("tenants")
        .upload(path, blob, { contentType: "image/jpeg", upsert: false });

      if (error) throw error;

      const { data } = supabase.storage.from("tenants").getPublicUrl(path);
      if (kind === "profile") setProfileImageUrl(data.publicUrl);
      else setCoverImageUrl(data.publicUrl);

      closeCropper();
      showToast(
        "success",
        "Fotoğraf yüklendi. Yayınlamak için Ayarları Kaydet'e basın.",
      );
    } catch (err) {
      console.error("Vitrin görseli yüklenemedi:", err);
      // Pencere kapanır: hata bildirimi (toast) panelin üstünde görünsün.
      closeCropper();
      showToast(
        "error",
        "Fotoğraf yüklenemedi. Bağlantınızı kontrol edip tekrar deneyin.",
      );
    } finally {
      setMediaSaving(null);
    }
  };

  // Seçilen il/ilçeye göre mahalle listesi (turkiyeapi.dev, route üzerinden cache'li)
  useEffect(() => {
    if (!province || !district) return;
    let cancelled = false;
    fetch(
      `/api/neighborhoods?province=${encodeURIComponent(province)}&district=${encodeURIComponent(district)}`,
    )
      .then((r) => r.json())
      .then((d) => {
        if (!cancelled)
          setNeighborhoods(
            Array.isArray(d.neighborhoods) ? d.neighborhoods : [],
          );
      })
      .catch(() => {
        if (!cancelled) setNeighborhoods([]);
      });
    return () => {
      cancelled = true;
    };
  }, [province, district]);

  const clearNeighborhoods = () => {
    setNeighborhoods([]);
    setNeighborhood("");
  };

  // Yazılan adresi Nominatim ile bul ve pini oraya taşı
  const findOnMap = async () => {
    const query = buildAddressQuery({
      province,
      district,
      neighborhood,
      street,
      building_no: buildingNo,
    });
    if (!query) {
      showToast("error", "Önce il ve ilçe bilgisini seçin.");
      return;
    }
    setGeoLoading(true);
    try {
      const res = await fetch(
        `/api/geocode?q=${encodeURIComponent(`${query}, Türkiye`)}`,
      );
      const json = await res.json();
      if (json.result) {
        setCoords({ lat: json.result.lat, lng: json.result.lng });
        showToast(
          "success",
          "Adres bulundu. Gerekirse pini sürükleyerek düzeltin.",
        );
      } else {
        showToast(
          "error",
          "Adres bulunamadı. Pini haritadan elle seçebilirsiniz.",
        );
      }
    } catch {
      showToast("error", "Adres servisine ulaşılamadı.");
    } finally {
      setGeoLoading(false);
    }
  };

  // Pin taşındığında/bırakıldığında boş kalan adres alanlarını konumdan tamamla
  const handlePinChange = async (lat: number, lng: number) => {
    setCoords({ lat, lng });
    try {
      const res = await fetch(`/api/geocode?lat=${lat}&lon=${lng}`);
      const json = await res.json();
      const r = json.result;
      if (!r) return;
      setProvince((prev) => prev || r.province || "");
      setDistrict((prev) => prev || r.district || "");
      setNeighborhood((prev) => prev || r.neighborhood || "");
      setStreet((prev) => prev || r.street || "");
      setBuildingNo((prev) => prev || r.building_no || "");
    } catch {
      // konum kaydedildi, adres alanları elle doldurulabilir
    }
  };

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!tenantId) return;
    setSaving(true);

    const normalizedHours = normalizeWorkingHours(workingHours);

    try {
      localStorage.setItem(
        `tenant_profile_${tenantId}`,
        JSON.stringify(profile),
      );
      localStorage.setItem(
        `tenant_hours_${tenantId}`,
        JSON.stringify(normalizedHours),
      );
      localStorage.setItem(
        `tenant_rules_${tenantId}`,
        JSON.stringify(bookingRules),
      );

      const res = await fetch("/api/tenant/update", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          tenantId,
          name: profile.name,
          phone: profile.phone,
          email: profile.email,
          address: profile.address,
          description: profile.description,
          province,
          district,
          neighborhood,
          street,
          building_no: buildingNo,
          latitude: coords?.lat ?? null,
          longitude: coords?.lng ?? null,
          theme_palette: themePalette,
          profile_image_url: profileImageUrl,
          cover_image_url: coverImageUrl,
          sector,
          working_hours: normalizedHours,
          booking_rules: bookingRules,
        }),
      });
      const data = await res.json();

      if (!res.ok || data.error) {
        console.error("API update failed:", data.error);
        showToast(
          "error",
          data.error || "Sunucu hatası, ayarlar kaydedilemedi!",
        );
      } else {
        showToast("success", "Ayarlar başarıyla güncellendi.");
      }
    } catch (err) {
      console.error("Save error:", err);
      showToast("error", "Bir hata oluştu, ayarlar kaydedilemedi.");
    } finally {
      setSaving(false);
    }
  };

  /**
   * ELEMAN kaydetme: kendi çalışma saatlerini ve kendi randevu kurallarını
   * staff_settings tablosuna yazar (RLS: satır yalnızca sahibi tarafından
   * yazılabilir). İşletme ayarlarına (/api/tenant/update) dokunmaz; o uç
   * zaten yalnızca sahip ve süper admine açıktır.
   */
  const handleStaffSettingsSave = async () => {
    if (!tenantId || !userId) return;
    setSaving(true);
    try {
      const { error } = await supabase.from("staff_settings").upsert({
        profile_id: userId,
        tenant_id: tenantId,
        working_hours: normalizeWorkingHours(workingHours),
        booking_rules: bookingRules,
        updated_at: new Date().toISOString(),
      });
      if (error) {
        console.error("Staff settings save error:", error);
        showToast("error", error.message);
      } else {
        showToast(
          "success",
          lang === "tr"
            ? "Ayarlarınız güncellendi."
            : "Your settings have been updated.",
        );
      }
    } catch (err) {
      console.error("Staff settings save error:", err);
      showToast("error", "Bir hata oluştu, ayarlar kaydedilemedi.");
    } finally {
      setSaving(false);
    }
  };

  const handleDayToggle = (day: string) => {
    setWorkingHours((prev) => {
      // Kayıtta gün eksikse varsayılanı temel al (liste 7 günü de gösterir)
      const current = prev[day] ?? defaultWorkingHours[day];
      if (
        !current.isOpen &&
        current.openTime === "00:00" &&
        current.closeTime === "00:00"
      ) {
        return {
          ...prev,
          [day]: { isOpen: true, openTime: "09:00", closeTime: "18:00" },
        };
      }
      return {
        ...prev,
        [day]: {
          ...current,
          isOpen: !current.isOpen,
        },
      };
    });
  };

  const handleTimeChange = (
    day: string,
    type: "openTime" | "closeTime",
    value: string,
  ) => {
    setWorkingHours((prev) => ({
      ...prev,
      [day]: {
        ...prev[day],
        [type]: value,
      },
    }));
  };

  if (loading) {
    return (
      <div className="flex h-[60vh] items-center justify-center">
        <Loader2 className="h-8 w-8 animate-spin text-indigo-600" />
      </div>
    );
  }

  // ELEMAN / SINIRLI GÖRÜNÜM: işletme profili ve konum-vitrin bilgileri bu
  // ekranda HİÇ görünmez. Yalnızca elemana özel çalışma saatleri ve randevu
  // kuralları gösterilir. Tam işletme ayarları yalnızca işletme sahibine
  // (role = "owner") açıktır; bu yüzden kapı "sahip değilse kısıtlı" şeklinde
  // kurulmuştur.
  if (role !== "owner") {
    return (
      <div className="animate-in fade-in slide-in-from-bottom-4 duration-700 max-w-2xl mx-auto pb-12 space-y-6">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 className="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
              {lang === "tr" ? "Ayarlarım" : "My Settings"}
            </h1>
            <p className="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">
              {lang === "tr"
                ? "Kendi çalışma saatleriniz ve randevu kurallarınız."
                : "Your own working hours and booking rules."}
            </p>
          </div>
          <button
            onClick={handleStaffSettingsSave}
            disabled={saving}
            className="inline-flex items-center gap-2 rounded-2xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-500/30 hover:bg-indigo-500 active:scale-95 disabled:opacity-50 transition-all"
          >
            {saving ? (
              <>
                <Loader2 size={18} className="animate-spin" />
                <span>{lang === "tr" ? "Kaydediliyor..." : "Saving..."}</span>
              </>
            ) : (
              <>
                <Save size={18} />
                <span>
                  {lang === "tr" ? "Ayarları Kaydet" : "Save Settings"}
                </span>
              </>
            )}
          </button>
        </div>

        <div className="flex items-start gap-2.5 rounded-2xl border border-indigo-200/70 bg-indigo-50/70 p-3.5 text-xs font-medium leading-relaxed text-indigo-800 dark:border-indigo-500/25 dark:bg-indigo-950/30 dark:text-indigo-200">
          <Info size={16} className="mt-0.5 shrink-0" />
          <span>
            {lang === "tr"
              ? "Bu ayarlar yalnızca sizin için geçerlidir: müşteri randevu akışında sizi seçtiğinde bu saatler ve kurallar uygulanır. Bir alanı değiştirmezseniz orada işletmenin ayarı geçerli olur. İşletme profilini, konumunu ve vitrinini yalnızca işletme sahibi yönetir; kendi hizmetlerinizi Hizmetler sayfasından düzenleyebilirsiniz."
              : "These settings apply to you only: when a customer selects you during booking, your hours and rules are used. Any field you leave untouched follows the business setting. The business profile, location and showcase are managed by the owner; manage your own services from the Services page."}
          </span>
        </div>

        <div>
          <div className="mb-2 pl-4">
            <h2 className="text-[13px] font-semibold uppercase tracking-widest text-gray-500 dark:text-slate-400">
              {lang === "tr" ? "Çalışma Saatlerim" : "My Working Hours"}
            </h2>
          </div>
          <WeeklyHoursList
            workingHours={workingHours}
            daysTranslation={daysTranslation}
            onDayToggle={handleDayToggle}
            onTimeChange={handleTimeChange}
          />
        </div>

        <div>
          <div className="mb-2 pl-4">
            <h2 className="text-[13px] font-semibold uppercase tracking-widest text-gray-500 dark:text-slate-400">
              {lang === "tr" ? "Randevu Kurallarım" : "My Booking Rules"}
            </h2>
          </div>
          <BookingRulesEditor
            rules={bookingRules}
            onChange={(patch) =>
              setBookingRules((prev) => ({ ...prev, ...patch }))
            }
          />
        </div>

        {/* Toast Notification */}
        {toast && (
          <div
            className={`fixed top-8 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 rounded-full border px-5 py-3 shadow-[0_8px_30px_rgb(0,0,0,0.12)] backdrop-blur-3xl transition-all duration-300 animate-in fade-in slide-in-from-top-8 ${
              toast.type === "success"
                ? "border-emerald-500/20 bg-emerald-50/90 text-emerald-800 dark:bg-emerald-950/90 dark:text-emerald-300"
                : "border-red-500/20 bg-red-50/90 text-red-800 dark:bg-red-950/90 dark:text-red-300"
            }`}
          >
            {toast.type === "success" ? (
              <CheckCircle2 size={20} />
            ) : (
              <AlertCircle size={20} />
            )}
            <span className="text-[15px] font-semibold">{toast.message}</span>
          </div>
        )}
      </div>
    );
  }

  return (
    <div className="animate-in fade-in slide-in-from-bottom-4 duration-700 max-w-5xl mx-auto pb-12">
      {/* Page Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <h1 className="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
            {t("settings.title")}
          </h1>
          <p className="mt-1 text-sm font-medium text-slate-500 dark:text-slate-400">
            {lang === "tr"
              ? "İşletme profili, çalışma saatleri ve randevu kurallarınızı yönetin."
              : "Manage business profile, hours, and booking rules."}
          </p>
        </div>

        {/* Header Save Button */}
        <div className="flex items-center gap-3">
          <button
            onClick={handleSave}
