@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

@theme inline {
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  
  /* Extreme squircles */
  --radius-2xl: 1.25rem;
  --radius-3xl: 1.75rem;
  --radius-4xl: 2.5rem;
  
  /* Mesh Background Animations */
  --animate-blob: blob 15s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
  --animate-blob-slow: blob 20s infinite alternate-reverse cubic-bezier(0.4, 0, 0.2, 1);
  
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(50px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-40px, 40px) scale(0.95);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }

  /* Modal Animations */
  --animate-modal-in: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  --animate-backdrop-in: backdropIn 0.25s ease-out forwards;

  /* Landing: yüzen kart animasyonu */
  --animate-float: float 6s ease-in-out infinite;

  /* Sekmeler arası swipe: yeni sayfanın giriş animasyonu */
  --animate-swipe-in-right: swipeInRight 0.3s cubic-bezier(0.22, 1, 0.36, 1)
    both;
  --animate-swipe-in-left: swipeInLeft 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;

  @keyframes swipeInRight {
    from {
      transform: translate3d(26%, 0, 0);
      opacity: 0.35;
    }
    to {
      transform: translate3d(0, 0, 0);
      opacity: 1;
    }
  }

  @keyframes swipeInLeft {
    from {
      transform: translate3d(-26%, 0, 0);
      opacity: 0.35;
    }
    to {
      transform: translate3d(0, 0, 0);
      opacity: 1;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes modalIn {
    0% {
      opacity: 0;
      transform: scale(0.92) translateY(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes backdropIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
}

html, body {
  height: 100%;
  width: 100%;
  overflow: hidden;
  overscroll-behavior: none;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  /* iOS: dokunma vurgusu ve tap gecikmesi kaldırılır (uygulama hissi) */
  -webkit-tap-highlight-color: transparent;
  -webkit-touch-callout: none;
}

/*
 * Çentik / home bar güvenli alanları tek yerden yönetilir.
 * `env()` değerleri ve kabuk ölçüleri burada toplanır; bileşenler (ör. alt
 * navigasyon) yalnızca `var(--safe-*)` okur — böylece hem tek kaynak kalır hem
 * de test/geliştirme sırasında değerler enjekte edilebilir.
 */
:root {
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --shell-pad: 0.5rem;
}

/* Alt navigasyon çubuğu: home bar payı + yanlarda çentik payı (yatay mod) */
.shell-bottomnav {
  padding-left: max(0.75rem, var(--safe-left));
  padding-right: max(0.75rem, var(--safe-right));
  padding-bottom: max(var(--safe-bottom), 0.6rem);
}

@media (min-width: 640px) {
  :root {
    --shell-pad: 1rem;
  }
}

@media (min-width: 768px) {
  :root {
    --shell-pad: 1.5rem;
  }
}

/*
 * Uygulama kabuğunun dış boşluğu. Tailwind `p-*` yerine burada tanımlanır çünkü
 * çentik/home-bar payı her kenarda ayrı ayrı `max()` ile birleştirilmelidir:
 * cihazda çentik yoksa (env = 0) normal boşluğa düşer, varsa çentiği geçer.
 * (Kenar çubuğu ve sayfa kartı aynı ölçüleri `SHELL` üzerinden paylaşır.)
 */
/*
 * Uygulama kabuğunun dış boşluğu. Tailwind `p-*` yerine burada tanımlanır çünkü
 * çentik/home-bar payı her kenarda ayrı ayrı `max()` ile birleştirilmelidir:
 * cihazda çentik yoksa (env = 0) normal boşluğa düşer, varsa çentiği geçer.
 * (Kenar çubuğu ve sayfa kartı aynı ölçüleri `SHELL` üzerinden paylaşır.)
 */
.shell-root {
  padding-top: max(var(--shell-pad), var(--safe-top));
  padding-bottom: max(var(--shell-pad), var(--safe-bottom));
  padding-left: max(var(--shell-pad), var(--safe-left));
  padding-right: max(var(--shell-pad), var(--safe-right));
}

/*
 * Dil kapısı (LanguageProvider): kayıtlı dil okunana kadar içerik gizlenir,
 * böylece EN seçen ısrarcı kullanıcı bir an Türkçe metin görmez.
 *
 * Ancak JS hiç çalışmazsa (yavaş/kesik bağlantı, çevrimdışı, chunk hatası)
 * içerik KALICI olarak gizli kalırdı: kullanıcı boş beyaz sayfa görüyordu.
 * Bu yüzden CSS tarafında bir emniyet supabı var — 4 saniye sonra kapı
 * kendiliğinden açılır. JS zamanında bağlanırsa sınıf tamamen kaldırılır ve
 * animasyon hiç devreye girmez.
 */
.lang-gate {
  visibility: hidden;
  animation: langGateReveal 0s linear 4s forwards;
}

@keyframes langGateReveal {
  to {
    visibility: visible;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lang-gate {
    animation-duration: 0s;
  }
}

/*
 * Belge tipi sayfalar (giriş, davet, yasal metinler, hata sayfaları).
 * Gövde `overflow: clip` olduğu için bu sayfalar kaydırmayı KENDİLERİ
 * üstlenmek zorundadır; aksi halde içerik çentiğin altında kırpılır ve
 * kullanıcı sayfayı kaydıramaz (100vh değil dvh: mobil araç çubuğu payı).
 */
.page-fill {
  height: 100dvh;
  overflow-y: auto;
  overflow-x: hidden;
  overscroll-behavior-y: contain;
  -webkit-overflow-scrolling: touch;
}

/* Yer varsa çocuğu dikeyde ortalar; içerik sığmadığında `justify-content:
   center` gibi üstten kırpmaz (auto margin kuralı). */
.page-fill > * {
  margin-block: auto;
}

/*
 * Dokunmatik cihazlarda mesh (blob) animasyonları kapatılır.
 * 3 adet animasyonlu `blur(3xl)` katmanı, mobil GPU'da her karede yeniden
 * rasterize edildiği için kaydırma sırasında belirgin takılma üretiyordu.
 * Statik mesh görsel olarak aynı kalır, kaydırma ise akıcı olur.
 */
@media (hover: none), (prefers-reduced-motion: reduce) {
  .animate-blob,
  .animate-blob-slow {
    animation: none !important;
  }
}

/* Hareket azaltma tercihinde swipe geçiş animasyonu da kapatılır.
   (Katmansız CSS, Tailwind `utilities` katmanını yendiği için `!important`
   gerekmez.) */
@media (prefers-reduced-motion: reduce) {
  .animate-swipe-in-right,
  .animate-swipe-in-left {
    animation: none;
    transform: none;
    opacity: 1;
  }
}

/* Kaydırılabilir her alan dokunmatikte ivmeli (momentum) kaydırmalı olmalı. */
.custom-scrollbar,
.scrollbar-none,
.shell-pane {
  -webkit-overflow-scrolling: touch;
}

/* clip: doküman programatik olarak da (scrollIntoView / window.scrollTo / hash /
   Next scroll restorasyonu) kaymasın. Kaydırma her zaman kabuğun kendi iç
   kaydırma alanlarında (pane / SHELL.main) yapılır; aksi halde fixed kabuk,
   dışarıdan gelen kaydırmalarla görünümden çıkabiliyor. Desteklemeyen
   tarayıcılar yukarıdaki overflow:hidden ile devam eder. */
@supports (overflow: clip) {
  html,
  body {
    overflow: clip;
  }
}

/* Shell konteynerlerinin asla scroll context oluşturmamasını garanti et:
   böylece mobil Safari/Chrome'da üst bar (header) kesinlikle yukarı kayıp kaybolamaz. */
.shell-root,
.shell-column {
  overflow: clip !important;
  overscroll-behavior: none !important;
}

@supports not (overflow: clip) {
  .shell-root,
  .shell-column {
    overflow: hidden !important;
  }
}

/* Placeholder Font: SF Pro */
::placeholder {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", sans-serif !important;
  opacity: 0.6;
}


/* Modern macOS style Custom Scrollbar */
.custom-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: rgba(148, 163, 184, 0.35) transparent;
}

.custom-scrollbar::-webkit-scrollbar {
  width: 14px;
  height: 14px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
  background-clip: padding-box;
  border: 4px solid transparent;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background-color: rgba(148, 163, 184, 0.35);
  background-clip: padding-box;
  border: 4px solid transparent;
  border-radius: 9999px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background-color: rgba(148, 163, 184, 0.6);
}

.dark .custom-scrollbar {
  scrollbar-color: rgba(148, 163, 184, 0.2) transparent;
}

.dark .custom-scrollbar::-webkit-scrollbar-thumb {
  background-color: rgba(148, 163, 184, 0.2);
}

.dark .custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background-color: rgba(148, 163, 184, 0.4);
}

/* Mobilde (lg altı) kaydırma çubukları tamamen gizlenir: içeriğin kenarında
   çubuk görünmez. Kaydırma/dokunmatik davranışı aynen çalışmaya devam eder. */
@media (max-width: 1023px) {
  .custom-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .custom-scrollbar::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
}

/* Görünmez (scrollbar'sız) yatay kaydırma alanı: mobil sekme/filtre çubukları */
.scrollbar-none {
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.scrollbar-none::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* ==========================================================================
   Modern SaaS User-Select Standards
   ========================================================================== */

/* 0. Dokunmatikte çift dokunuşla yakınlaştırma ve 300ms tap gecikmesi kapatılır.
   (Metin girişleri hariç: kullanıcı uzun basıp seçebilmeli.) */
button,
[role="button"],
a[href],
nav,
select,
summary,
label[for],
input[type="checkbox"],
input[type="radio"] {
  touch-action: manipulation;
}

/* 1. Global & Interactive controls: disable text selection to prevent accidental blue highlights */
button,
[role="button"],
a,
nav,
select,
th,
svg,
summary,
.select-none {
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

/* 2. Data fields, inputs, textareas, table cells & content: preserve selection and copying */
input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]):not([type="reset"]),
textarea,
td,
code,
pre,
.select-text {
  -webkit-user-select: text;
  -moz-user-select: text;
  -ms-user-select: text;
  user-select: text;
}


/* ==========================================================================
   Landing (tanıtım sayfası)
   Gövde `overflow: hidden` olduğu için bu sayfa kendi kaydırma kabını kullanır;
   kaydırma ile ortaya çıkan bölümler `data-reveal` + `.reveal` ile canlanır.
   Animasyon bitince sınıflar JS tarafından kaldırılır; böylece kartların kendi
   hover geçişleri (Tailwind `transition-*`) animasyon süresinden etkilenmez.
   ========================================================================== */

.reveal {
  opacity: 0;
  transform: translateY(22px);
  transition:
    opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}

.reveal.is-visible {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .reveal *,
  .reveal::before,
  .reveal::after {
    animation: none;
  }
}

/* Varsayılan marka paleti (indigo). İşletme sayfaları `.brand-scope` ile kendi paletini
   tanımlar; scope dışındaki bileşenler (ör. dashboard'daki gönderi modalı) bu değerleri kullanır. */
:root {
  --brand: oklch(51.1% 0.262 276.966);
  --brand-strong: oklch(45.7% 0.24 277.023);
  --brand-soft: oklch(96.2% 0.018 272.314);
  --brand-soft-hover: oklch(93% 0.034 272.788);
  --brand-text: oklch(45.7% 0.24 277.023);
  --brand-border: oklch(87% 0.065 274.039);
  --brand-shadow: color-mix(in srgb, var(--brand) 30%, transparent);
}

.dark {
  --brand: oklch(58.5% 0.233 277.117);
  --brand-strong: oklch(67.3% 0.182 276.935);
  --brand-soft: oklch(25.7% 0.09 281.288);
  --brand-soft-hover: oklch(35.9% 0.144 278.697);
  --brand-text: oklch(78.5% 0.115 274.713);
  --brand-border: oklch(39.8% 0.195 277.366);
}
