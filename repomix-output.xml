        return {
          ...prev,
          [day]: { isOpen: true, openTime: "09:00", closeTime: "18:00" },
        };
      }
      return {
        ...prev,
        [day]: {
          ...current,
          isOpen: !current.isOpen,
        },
      };
    });
  };

