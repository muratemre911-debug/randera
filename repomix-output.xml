                  }
                  className="w-full rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 p-3.5 text-sm text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-[var(--brand)]/20 focus:border-[var(--brand)] transition-all resize-none"
                />
              </div>

              {/* Buttons */}
              <div className="flex items-center gap-3 pt-2">
                <button
                  type="button"
                  onClick={cancelEdit}
                  disabled={loading}
                  className="flex-1 py-3 px-4 rounded-full border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs sm:text-sm hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                >
                  {lang === "tr" ? "Vazgeç" : "Cancel"}
                </button>
                <button
                  type="submit"
                  disabled={loading}
                  className="flex-1 py-3 px-4 rounded-full bg-[var(--brand)] hover:bg-[var(--brand-strong)] text-white font-extrabold text-xs sm:text-sm shadow-md shadow-[color:var(--brand-shadow)] active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
                >
                  {loading ? (
                    <>
                      <Loader2 size={16} className="animate-spin" />
                      <span>
                        {lang === "tr" ? "Kaydediliyor..." : "Saving..."}
                      </span>
                    </>
                  ) : (
                    <span>
                      {lang === "tr" ? "Değişiklikleri Kaydet" : "Save Changes"}
                    </span>
                  )}
                </button>
              </div>
            </form>
          ) : (
            /* LIST VIEW OF USER PAST REVIEWS */
            <div className="space-y-3">
              {reviews.length === 0 ? (
                <div className="py-8 text-center text-slate-400 dark:text-slate-500 text-sm">
                  {lang === "tr"
                    ? "Henüz bu işletmeye yaptığınız bir değerlendirme bulunmuyor."
                    : "You have not written any reviews for this business yet."}
                </div>
              ) : (
                reviews.map((rev) => (
                  <div
                    key={rev.appointment_id}
                    className="p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-700/60 space-y-2.5 transition-all hover:border-slate-300 dark:hover:border-slate-600"
                  >
                    <div className="flex items-start justify-between gap-3">
                      <div>
                        <div className="flex items-center gap-2">
                          <span className="font-bold text-sm text-slate-900 dark:text-white">
                            {rev.service_name ||
                              (lang === "tr" ? "Hizmet" : "Service")}
                          </span>
                          <span className="flex items-center gap-1 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
                            <ShieldCheck size={12} />
                            {lang === "tr" ? "Doğrulanmış" : "Verified"}
                          </span>
                        </div>
                        <p className="text-[11px] text-slate-400 mt-0.5">
                          {format(parseISO(rev.created_at), "d MMMM yyyy", {
                            locale,
                          })}
                        </p>
                      </div>

                      {/* Stars & Edit Button */}
                      <div className="flex items-center gap-2 shrink-0">
                        <div className="flex items-center gap-0.5 text-amber-400">
                          {[1, 2, 3, 4, 5].map((s) => (
                            <Star
                              key={s}
                              size={12}
                              className={
                                s <= rev.rating
                                  ? "fill-amber-400 text-amber-400"
                                  : "text-slate-200 dark:text-slate-700"
                              }
                            />
                          ))}
                        </div>
                        <button
                          type="button"
                          onClick={() => startEdit(rev)}
                          className="inline-flex items-center gap-1 px-3 py-1 rounded-xl bg-[var(--brand-soft)] hover:bg-[var(--brand-soft-hover)] bg-[var(--brand-soft)] hover:bg-[var(--brand-soft-hover)] text-[var(--brand-text)] text-[var(--brand-text)] text-xs font-bold transition-colors cursor-pointer"
                        >
                          <Edit3 size={12} />
                          <span>{lang === "tr" ? "Düzenle" : "Edit"}</span>
                        </button>
                      </div>
                    </div>

                    {/* Review text */}
                    {rev.comment ? (
                      <p className="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed italic bg-white/60 dark:bg-slate-900/40 p-3 rounded-xl border border-slate-100 dark:border-slate-800">
                        &ldquo;{rev.comment}&rdquo;
                      </p>
                    ) : (
                      <p className="text-xs text-slate-400 italic">
                        {lang === "tr"
                          ? "(Yorum metni yazılmamış, sadece puan verildi)"
                          : "(No text comment, rating only)"}
                      </p>
                    )}
                  </div>
                ))
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/MapPoint.tsx">
"use client";

import { useEffect, useRef } from "react";
import type { Map as LeafletMap, Marker as LeafletMarker } from "leaflet";
import "leaflet/dist/leaflet.css";
import { TURKEY_CENTER, TURKEY_ZOOM } from "@/lib/provinceCoords";
import { preventMapFocusScroll } from "@/lib/preventMapFocusScroll";

interface MapPointProps {
  lat: number | null;
  lng: number | null;
  /** Verilirse pin sürüklenebilir ve haritaya tıklayınca konum değişir. */
  onChange?: (lat: number, lng: number) => void;
  /** Pin yoksa haritanın açılacağı yer (ör. seçilen il merkezi). */
  center?: [number, number] | null;
  centerZoom?: number;
  zoom?: number;
  heightClass?: string;
  pinLabel?: string;
  className?: string;
}

const OSM_TILES = "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png";
const OSM_ATTRIBUTION =
  '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a>';

function pinHtml(label: string) {
  return `
    <div style="transform: translate(-50%, -100%)" class="relative flex flex-col items-center">
      <div class="px-2.5 py-1 rounded-full bg-indigo-600 text-white text-[11px] font-bold shadow-md whitespace-nowrap">${label}</div>
      <div class="w-0 h-0 border-x-4 border-x-transparent border-t-4 border-t-indigo-600"></div>
    </div>`;
}

export default function MapPoint({
  lat,
  lng,
  onChange,
  center = null,
  centerZoom = 12,
  zoom = 15,
  heightClass = "h-72",
  pinLabel = "İşletmem",
  className = "",
}: MapPointProps) {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const mapRef = useRef<LeafletMap | null>(null);
  const markerRef = useRef<LeafletMarker | null>(null);
  const changeRef = useRef(onChange);

  useEffect(() => {
    changeRef.current = onChange;
  }, [onChange]);

  useEffect(() => {
    let cancelled = false;

    import("leaflet").then((L) => {
      if (cancelled || mapRef.current || !containerRef.current) return;

      const editable = Boolean(changeRef.current);
      const hasPoint = lat != null && lng != null;
      const start: [number, number] = hasPoint
        ? [lat, lng]
        : (center ?? TURKEY_CENTER);

      const map = L.map(containerRef.current, {
        center: start,
        zoom: hasPoint ? zoom : center ? centerZoom : TURKEY_ZOOM,
        zoomControl: true,
        minZoom: 5,
        maxZoom: 18,
      });

      L.tileLayer(OSM_TILES, {
        maxZoom: 19,
        attribution: OSM_ATTRIBUTION,
      }).addTo(map);

      // Harita/zoom kontrolüne dokununca sayfa kaymasın (Leaflet focus() verir)
      preventMapFocusScroll(map.getContainer());

      mapRef.current = map;

      if (lat != null && lng != null) {
        markerRef.current = L.marker(start, {
          draggable: editable,
          icon: L.divIcon({
            className: "",
            html: pinHtml(pinLabel),
            iconSize: [0, 0],
            iconAnchor: [0, 0],
          }),
          autoPan: true,
        }).addTo(map);
      }

      if (editable) {
        const place = (plat: number, plng: number) => {
          if (!markerRef.current) {
            markerRef.current = L.marker([plat, plng], {
              draggable: true,
              icon: L.divIcon({
                className: "",
                html: pinHtml(pinLabel),
                iconSize: [0, 0],
                iconAnchor: [0, 0],
              }),
              autoPan: true,
            }).addTo(map);
            markerRef.current.on("dragend", () => {
              const p = markerRef.current!.getLatLng();
              changeRef.current?.(p.lat, p.lng);
            });
          } else {
            markerRef.current.setLatLng([plat, plng]);
          }
        };

        map.on("click", (e) => {
          place(e.latlng.lat, e.latlng.lng);
          changeRef.current?.(e.latlng.lat, e.latlng.lng);
        });
      }

      setTimeout(() => map.invalidateSize(), 0);
    });

    return () => {
      cancelled = true;
      mapRef.current?.remove();
      mapRef.current = null;
      markerRef.current = null;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Pin yokken seçilen il/ilçe değişirse haritayı oraya taşı
  useEffect(() => {
    const map = mapRef.current;
    if (!map || lat != null || !center) return;
    map.setView(center, centerZoom);
  }, [center, centerZoom, lat]);

  // Dışarıdan gelen konum değişikliklerini (adresten bul, kayıt sonrası) yansıt
  useEffect(() => {
    const map = mapRef.current;
    const marker = markerRef.current;
    if (!map || lat == null || lng == null) return;

    if (!marker) return; // pin yoksa haritayı ilk kurulumda konumlandır
    const current = marker.getLatLng();
    if (
      Math.abs(current.lat - lat) < 1e-6 &&
      Math.abs(current.lng - lng) < 1e-6
    )
      return;
    marker.setLatLng([lat, lng]);
    map.setView([lat, lng], Math.max(map.getZoom(), 15));
  }, [lat, lng]);

  return (
    <div
      ref={containerRef}
      data-no-swipe
      className={`w-full ${heightClass} rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 z-0 ${className}`}
    />
  );
}
</file>

<file path="src/components/RequirePhoneModal.tsx">
"use client";

import { useState } from "react";
import {
  Phone,
  ShieldAlert,
  Loader2,
  LogOut,
  CheckCircle2,
} from "lucide-react";
import { createClient } from "@/utils/supabase/client";
import { useLanguage } from "@/context/LanguageContext";
import { useRouter } from "next/navigation";
import {
  inspectTrMobile,
  trMobileErrorMessage,
  TR_MOBILE_PLACEHOLDER,
} from "@/lib/phone";

interface RequirePhoneModalProps {
  isOpen: boolean;
  onSuccess: (phone: string) => void;
}

export default function RequirePhoneModal({
  isOpen,
  onSuccess,
}: RequirePhoneModalProps) {
  const supabase = createClient();
  const router = useRouter();
  const { lang } = useLanguage();

  const [phone, setPhone] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  if (!isOpen) return null;

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);

    // Biçim + uydurma desen kontrolü (sunucu da aynı kontrolü yeniden yapar)
    const check = inspectTrMobile(phone);
    if (!check.ok) {
      setError(trMobileErrorMessage(check.issue, lang));
      return;
    }

    setLoading(true);
    try {
      // Kaydetme sunucu üzerinden yapılır: "bir numara yalnızca bir hesapta"
      // kuralı başka profilleri okumayı gerektirir, istemciden kontrol edilemez.
      const res = await fetch("/api/phone", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: check.phone }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        throw new Error(
          data?.error ||
            (lang === "tr"
              ? "Telefon kaydedilirken bir hata oluştu."
              : "Failed to save phone number."),
        );
      }

      onSuccess(data?.phone || check.phone);
    } catch (err) {
      setError(
        (err instanceof Error && err.message) ||
          (lang === "tr"
            ? "Telefon kaydedilirken bir hata oluştu."
            : "Failed to save phone number."),
      );
    } finally {
      setLoading(false);
    }
  };

  const handleLogout = async () => {
    await supabase.auth.signOut();
    router.push("/login");
  };

  return (
    <div data-no-swipe className="fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-black/75 backdrop-blur-md animate-in fade-in duration-300">
      <div
        className="w-full max-w-md bg-white dark:bg-slate-900 rounded-[32px] p-6 sm:p-8 shadow-2xl border border-white/60 dark:border-slate-800 text-center space-y-5 animate-in zoom-in-95 duration-200"
        onClick={(e) => e.stopPropagation()}
      >
        <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--brand-soft)] text-[var(--brand-text)] ring-8 ring-[var(--brand-soft)]">
          <Phone size={32} />
        </div>

        <div className="space-y-2">
          <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300 text-xs font-bold uppercase tracking-wider">
            <ShieldAlert size={13} />
            {lang === "tr" ? "Zorunlu Adım" : "Required Step"}
          </div>
          <h2 className="text-2xl font-black text-gray-900 dark:text-white tracking-tight">
            {lang === "tr"
              ? "Telefon Numaranızı Ekleyin"
              : "Add Your Phone Number"}
          </h2>
          <p className="text-xs sm:text-sm text-gray-500 dark:text-slate-400 leading-relaxed">
            {lang === "tr"
              ? "Randevularınızın işletme tarafından onaylanması ve size ulaşabilmesi için telefon numaranızı kaydetmeniz zorunludur. Aynı numara yalnızca bir hesapta kullanılabilir."
              : "A phone number is required so businesses can confirm your appointments and reach you. A number can only be used by one account."}
          </p>
        </div>

        <form onSubmit={handleSubmit} className="space-y-4 pt-2">
          <div className="text-left">
            <label className="block text-xs font-bold text-gray-700 dark:text-slate-300 mb-1.5">
              {lang === "tr" ? "Telefon Numarası" : "Phone Number"}{" "}
              <span className="text-red-500">*</span>
            </label>
            <div className="relative">
              <input
                type="tel"
                required
                autoFocus
                value={phone}
                onChange={(e) => setPhone(e.target.value)}
                placeholder={TR_MOBILE_PLACEHOLDER}
                className="w-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-gray-50/80 dark:bg-slate-800/80 px-4 py-3.5 text-base font-semibold text-gray-900 dark:text-white placeholder-gray-400 outline-none focus:border-[var(--brand)] focus:ring-2 focus:ring-[var(--brand)]/20 transition-all"
              />
            </div>
            {error && (
              <p className="mt-2 text-xs font-bold text-rose-600 dark:text-rose-400">
                {error}
              </p>
            )}
          </div>

          <button
            type="submit"
            disabled={loading}
            className="w-full flex items-center justify-center gap-2 py-4 rounded-2xl bg-[var(--brand)] hover:bg-[var(--brand-strong)] text-white font-bold text-sm shadow-lg shadow-[color:var(--brand-shadow)] transition-all active:scale-98 disabled:opacity-50"
          >
            {loading ? (
              <Loader2 size={18} className="animate-spin" />
            ) : (
              <CheckCircle2 size={18} />
            )}
            <span>
              {lang === "tr"
                ? "Numaramı Kaydet ve Devam Et"
                : "Save and Continue"}
            </span>
          </button>
        </form>

        <div className="pt-2 border-t border-gray-100 dark:border-slate-800">
          <button
            type="button"
            onClick={handleLogout}
            className="inline-flex items-center gap-1.5 text-xs font-bold text-gray-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors"
          >
            <LogOut size={13} />
            {lang === "tr"
              ? "Farklı bir hesapla giriş yap / Çıkış"
              : "Sign out"}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/ReviewModal.tsx">
"use client";

import React, { useState, useEffect } from "react";
import { Star, X, CheckCircle2, Loader2, Sparkles } from "lucide-react";

interface ReviewModalProps {
  isOpen: boolean;
  onClose: () => void;
  appointmentId: string;
  businessName: string;
  serviceName?: string;
  initialRating?: number;
  initialComment?: string;
  onSuccess: (review: { rating: number; comment: string }) => void;
}

const RATING_LABELS: Record<number, { tr: string; en: string }> = {
  5: { tr: "Olağanüstü! 🌟", en: "Outstanding! 🌟" },
  4: { tr: "Çok İyi 👍", en: "Very Good 👍" },
  3: { tr: "İyi 🙂", en: "Good 🙂" },
  2: { tr: "İdare Eder 😐", en: "Fair 😐" },
  1: { tr: "Memnun Kalmadım 👎", en: "Poor 👎" },
};

export default function ReviewModal({
  isOpen,
  onClose,
  appointmentId,
  businessName,
  serviceName,
  initialRating = 5,
  initialComment = "",
  onSuccess,
}: ReviewModalProps) {
  const [rating, setRating] = useState(initialRating);
  const [hoverRating, setHoverRating] = useState(0);
  const [comment, setComment] = useState(initialComment);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [submitted, setSubmitted] = useState(false);

  useEffect(() => {
    /* eslint-disable react-hooks/set-state-in-effect -- modal her açılışta başlangıç değerlerine sıfırlanır */
    if (isOpen) {
      setRating(initialRating || 5);
      setComment(initialComment || "");
      setError("");
      setSubmitted(false);
    }
    /* eslint-enable react-hooks/set-state-in-effect */
  }, [isOpen, initialRating, initialComment]);

  if (!isOpen) return null;

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (rating < 1) {
      setError("Lütfen en az 1 yıldız seçin.");
      return;
    }

    setLoading(true);
    setError("");

    try {
      const res = await fetch("/api/reviews", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          appointment_id: appointmentId,
          rating,
          comment: comment.trim(),
        }),
      });

      const data = await res.json();
      if (!res.ok || data.error) {
        throw new Error(data.error || "Değerlendirme kaydedilemedi.");
      }

      setSubmitted(true);
      onSuccess({ rating, comment: comment.trim() });
      setTimeout(() => {
        onClose();
      }, 1500);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Bir hata oluştu.");
    } finally {
      setLoading(false);
    }
  };

  const currentDisplayRating = hoverRating || rating;

  return (
    <div data-no-swipe className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-200">
      <div className="fixed inset-0" onClick={() => !loading && onClose()} />

      <div className="relative w-full max-w-md bg-white/95 dark:bg-slate-900/95 backdrop-blur-3xl rounded-[32px] border border-white/60 dark:border-slate-800 shadow-2xl p-6 sm:p-7 overflow-hidden z-10 animate-in zoom-in-95 duration-200">
        {/* Close Button */}
        <button
          type="button"
          onClick={onClose}
          disabled={loading}
          className="absolute top-4 right-4 p-2 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors"
        >
          <X size={16} />
        </button>

        {submitted ? (
          <div className="py-10 text-center flex flex-col items-center gap-3 animate-in zoom-in-90 duration-300">
            <div className="w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shadow-lg shadow-emerald-500/10">
              <CheckCircle2 size={36} />
            </div>
            <h3 className="text-xl font-black text-slate-900 dark:text-white">
              Teşekkürler!
            </h3>
            <p className="text-sm font-medium text-slate-500 dark:text-slate-400 max-w-xs">
              Değerlendirmeniz başarıyla kaydedildi ve işletme sayfasında
              yayınlandı.
            </p>
          </div>
        ) : (
          <form onSubmit={handleSubmit} className="space-y-5">
            {/* Header */}
            <div>
              <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--brand-soft)] bg-[var(--brand-soft)] text-[var(--brand-text)] text-[var(--brand-text)] text-xs font-bold mb-2">
                <Sparkles size={13} />
                <span>Deneyiminizi Paylaşın</span>
              </div>
              <h3 className="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
                {businessName}
              </h3>
              {serviceName && (
                <p className="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                  Hizmet:{" "}
                  <span className="font-semibold text-slate-700 dark:text-slate-300">
                    {serviceName}
                  </span>
                </p>
              )}
            </div>

            {error && (
              <div className="p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 text-xs font-bold border border-rose-200 dark:border-rose-900/50">
                {error}
              </div>
            )}

            {/* Interactive Stars */}
            <div className="flex flex-col items-center py-2 bg-slate-50/70 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-800">
              <div className="flex items-center gap-2">
                {[1, 2, 3, 4, 5].map((star) => {
                  const isFilled = star <= currentDisplayRating;
                  return (
                    <button
                      key={star}
                      type="button"
                      onClick={() => setRating(star)}
                      onMouseEnter={() => setHoverRating(star)}
                      onMouseLeave={() => setHoverRating(0)}
                      className="p-1 sm:p-1.5 transition-transform hover:scale-125 active:scale-95 focus:outline-none cursor-pointer"
                    >
                      <Star
                        size={32}
                        className={`transition-colors duration-150 ${
                          isFilled
                            ? "fill-amber-400 text-amber-400 drop-shadow-[0_2px_8px_rgba(251,191,36,0.4)]"
                            : "text-slate-300 dark:text-slate-600"
                        }`}
                      />
                    </button>
                  );
                })}
              </div>
              <span className="text-xs font-bold text-slate-600 dark:text-slate-300 mt-2">
                {RATING_LABELS[currentDisplayRating]?.tr || "Puanınızı seçin"}
              </span>
            </div>

            {/* Comment Area */}
            <div>
              <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                Yorumunuz (İsteğe Bağlı)
              </label>
              <textarea
                value={comment}
                onChange={(e) => setComment(e.target.value)}
                placeholder="Personelin ilgisi, temizlik, randevu zamanlaması nasıldı? Deneyiminizi birkaç cümleyle anlatın..."
                rows={4}
                className="w-full p-3.5 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/60 text-xs sm:text-sm font-medium text-slate-800 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[var(--brand)] transition-all resize-none"
              />
            </div>

            {/* Actions */}
            <div className="flex items-center gap-3 pt-1">
              <button
                type="button"
                onClick={onClose}
                disabled={loading}
                className="flex-1 py-3 px-4 rounded-2xl border border-slate-200 dark:border-slate-700 font-bold text-xs sm:text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              >
                Vazgeç
              </button>
              <button
                type="submit"
                disabled={loading || rating < 1}
                className="flex-1 py-3 px-4 rounded-2xl bg-[var(--brand)] hover:bg-[var(--brand-strong)] text-white font-extrabold text-xs sm:text-sm shadow-md shadow-[color:var(--brand-shadow)] transition-all active:scale-95 disabled:opacity-50 flex items-center justify-center gap-2 cursor-pointer"
              >
                {loading ? (
                  <>
                    <Loader2 size={16} className="animate-spin" />
                    <span>Gönderiliyor...</span>
                  </>
                ) : (
                  <span>Değerlendirmeyi Gönder</span>
                )}
              </button>
            </div>
          </form>
        )}
      </div>
    </div>
  );
}
