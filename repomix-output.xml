<file path="src/app/api/admin/accounts/route.ts">
import { NextResponse } from "next/server";
import {
  createClient as createServerClient,
  createAdminClient,
} from "@/utils/supabase/server";
import { isSuperAdmin } from "@/lib/admin";
import { getMembership } from "@/lib/membership";

export interface AdminAccount {
  userId: string;
  fullName: string;
  email: string;
  role: string;
  phone: string | null;
  createdAt: string | null;
  tenantId: string | null;
  tenantName: string | null;
  sector: string | null;
  tenantIsActive: boolean | null;
  membership: ReturnType<typeof getMembership>;
  appointmentCount: number;
}

/** auth.users tablosunu sayfalayarak tamamını çeker (varsayılan sayfa 50 ile sınırlı). */
async function fetchAllEmails(
  admin: ReturnType<typeof createAdminClient>,
): Promise<Map<string, string>> {
  const emails = new Map<string, string>();
  const perPage = 1000;

  for (let page = 1; page <= 20; page++) {
    const { data, error } = await admin.auth.admin.listUsers({ page, perPage });
    if (error) throw error;
    const users = data?.users ?? [];
    users.forEach((u) => {
      if (u.email) emails.set(u.id, u.email);
    });
    if (users.length < perPage) break;
  }

  return emails;
}

export async function GET() {
  try {
    const supabaseUser = await createServerClient();
    const {
      data: { user },
    } = await supabaseUser.auth.getUser();
    if (!user || !isSuperAdmin(user.email)) {
      return NextResponse.json({ error: "Yetkisiz işlem." }, { status: 403 });
    }

    const admin = createAdminClient();

    const [
      { data: profiles, error: profileError },
      { data: tenants, error: tenantError },
      { data: appointments },
      emails,
    ] = await Promise.all([
      admin
        .from("profiles")
        .select("id, full_name, role, phone, created_at, tenant_id")
        .order("created_at", { ascending: false }),
      admin
        .from("tenants")
        .select(
          "id, name, sector, is_active, membership_status, trial_ends_at, membership_ends_at",
        ),
      admin.from("appointments").select("customer_id"),
      fetchAllEmails(admin),
    ]);

    if (profileError) throw profileError;
    if (tenantError) throw tenantError;

    type TenantRow = {
      id: string;
      name: string;
      sector: string | null;
      is_active: boolean | null;
      membership_status: string | null;
      trial_ends_at: string | null;
      membership_ends_at: string | null;
    };

    const tenantMap = new Map<string, TenantRow>(
      ((tenants ?? []) as TenantRow[]).map((t) => [t.id, t]),
    );

    const appointmentCounts = new Map<string, number>();
    (appointments ?? []).forEach((a: { customer_id: string | null }) => {
      if (!a.customer_id) return;
      appointmentCounts.set(
        a.customer_id,
        (appointmentCounts.get(a.customer_id) || 0) + 1,
      );
    });

    const accounts: AdminAccount[] = (profiles ?? []).flatMap((p) => {
      const email = emails.get(p.id);
      if (!email) return []; // auth kaydı olmayan (silinmiş) profilleri atla

      const tenant = p.tenant_id ? tenantMap.get(p.tenant_id) : undefined;
      return [
        {
          userId: p.id,
          fullName: p.full_name || "İsimsiz",
          email,
          role: p.role || "customer",
          phone: p.phone || null,
          createdAt: p.created_at,
          tenantId: tenant?.id ?? null,
          tenantName: tenant?.name ?? null,
          sector: tenant?.sector ?? null,
          tenantIsActive: tenant?.is_active ?? null,
          membership: getMembership({
            membership_status: tenant?.membership_status,
            trial_ends_at: tenant?.trial_ends_at,
            membership_ends_at: tenant?.membership_ends_at,
          }),
          appointmentCount: appointmentCounts.get(p.id) || 0,
        },
      ];
    });

    return NextResponse.json(accounts);
  } catch (err) {
    console.error(
      "admin accounts error:",
      err instanceof Error ? err.message : err,
    );
    return NextResponse.json(
      { error: err instanceof Error ? err.message : "Beklenmeyen hata" },
      { status: 500 },
    );
  }
}
</file>

<file path="src/app/api/admin/membership/route.ts">
import { NextResponse } from "next/server";
import { revalidatePath } from "next/cache";
import {
  createClient as createServerClient,
  createAdminClient,
} from "@/utils/supabase/server";
import { isSuperAdmin } from "@/lib/admin";
import {
  MONTHLY_DAYS,
  TRIAL_DAYS,
  getMembership,
  shiftEndDate,
  type MembershipStatus,
} from "@/lib/membership";
import { generateBaseSlug, generateUniqueSlug } from "@/lib/slug";
import {
  PROTECTED_TENANT_ERROR,
  isProtectedTenant,
} from "@/lib/protectedTenant";
import { adminMembershipSchema, validateRequest } from "@/lib/validations";

interface TenantMembershipRow {
  membership_status: string | null;
  trial_ends_at: string | null;
  membership_ends_at: string | null;
}

const SELECT = "membership_status, trial_ends_at, membership_ends_at";

export async function POST(req: Request) {
  try {
    const supabaseUser = await createServerClient();
    const {
      data: { user },
    } = await supabaseUser.auth.getUser();
    if (!user || !isSuperAdmin(user.email)) {
      return NextResponse.json({ error: "Yetkisiz işlem." }, { status: 403 });
    }

    const validation = validateRequest(adminMembershipSchema, await req.json());
    if (!validation.success) {
      return NextResponse.json({ error: validation.error }, { status: 400 });
    }
    const { action, userId, days, tenantName, sector } = validation.data;

    const admin = createAdminClient();
    const now = new Date();
    let tenantId = validation.data.tenantId ?? null;
    let createdTenant = false;

    // Müşteri hesabına işletme yetkisi: önce işletme oluştur, profili sahiplendir
    if (!tenantId && userId) {
      const { data: profile, error: profileError } = await admin
        .from("profiles")
        .select("tenant_id")
        .eq("id", userId)
        .single();
      if (profileError) throw profileError;
      if (profile?.tenant_id) {
        return NextResponse.json(
          { error: "Bu hesabın zaten bir işletmesi var." },
          { status: 400 },
        );
      }

      const slug = await generateUniqueSlug(
        admin,
        generateBaseSlug(tenantName!),
      );
      const { data: created, error: createError } = await admin
        .from("tenants")
        .insert({ name: tenantName, slug, sector, is_active: true })
        .select("id")
        .single();
      if (createError) throw createError;
      tenantId = created.id;
      createdTenant = true;

      const { error: profileUpdateError } = await admin
        .from("profiles")
        .update({ tenant_id: tenantId, role: "owner" })
        .eq("id", userId);
      if (profileUpdateError) throw profileUpdateError;
    }

    if (!tenantId) {
      return NextResponse.json(
        { error: "Hedef işletme bulunamadı." },
        { status: 400 },
      );
    }

    // Süper admin işletmesi: sınırsız üyelik, işlem yapılamaz
    if (await isProtectedTenant(tenantId)) {
      if (!createdTenant) {
        return NextResponse.json(
          { error: PROTECTED_TENANT_ERROR },
          { status: 403 },
        );
      }
      // Yeni oluşturulan işletme süper admine aitse işlem uygulanmaz; sınırsız kalır.
      const { data: unlimited } = await admin
        .from("tenants")
        .select(`${SELECT}, is_active`)
        .eq("id", tenantId)
        .single();
      return NextResponse.json({
        success: true,
        tenantId,
        isActive: unlimited?.is_active ?? true,
        membership: getMembership(
          (unlimited ?? {}) as TenantMembershipRow,
          now,
        ),
      });
    }

    const { data: tenant, error: tenantError } = await admin
      .from("tenants")
      .select(SELECT)
      .eq("id", tenantId)
      .single();
    if (tenantError) throw tenantError;

    const current = tenant as TenantMembershipRow;
    const patch: Record<string, unknown> = {};

    switch (action) {
      case "load-trial": {
        const status: MembershipStatus =
          getMembership(current, now).kind === "active" ? "active" : "trial";
        patch.trial_ends_at = shiftEndDate(
          current.trial_ends_at,
          TRIAL_DAYS,
          now,
        );
        patch.membership_status = status;
        break;
      }
      case "load-monthly":
      case "load-custom": {
        const add = action === "load-monthly" ? MONTHLY_DAYS : days!;
        patch.membership_ends_at = shiftEndDate(
          current.membership_ends_at,
          add,
          now,
        );
        patch.membership_status = "active" satisfies MembershipStatus;
        break;
      }
      case "adjust": {
        // Süresi işleyen alanı (üyelik varsa üyelik, yoksa deneme) kaydır
        const info = getMembership(current, now);
        if (info.kind === "active") {
          patch.membership_ends_at = shiftEndDate(
            current.membership_ends_at,
            days!,
            now,
          );
        } else {
          patch.trial_ends_at = shiftEndDate(current.trial_ends_at, days!, now);
        }
        break;
      }
      case "suspend":
        patch.membership_status = "suspended" satisfies MembershipStatus;
        patch.is_active = false;
        break;
      case "activate": {
        const restored = getMembership(
          { ...current, membership_status: "active" },
          now,
        );
        patch.membership_status = (
          restored.kind === "trial" ? "trial" : "active"
        ) satisfies MembershipStatus;
        patch.is_active = true;
        break;
      }
    }

    const { error: updateError } = await admin
      .from("tenants")
      .update(patch)
      .eq("id", tenantId);
    if (updateError) throw updateError;

    const { data: updated } = await admin
      .from("tenants")
      .select(`${SELECT}, is_active`)
      .eq("id", tenantId)
      .single();

    revalidatePath("/discover", "page");
    revalidatePath("/dashboard", "layout");
    revalidatePath("/", "layout");

    return NextResponse.json({
      success: true,
      tenantId,
      isActive: updated?.is_active ?? null,
      membership: getMembership(
        (updated ?? current) as TenantMembershipRow,
        now,
      ),
    });
  } catch (err) {
    console.error(
      "admin membership error:",
      err instanceof Error ? err.message : err,
    );
    return NextResponse.json(
      { error: err instanceof Error ? err.message : "Beklenmeyen hata" },
      { status: 500 },
    );
  }
}
</file>

<file path="src/app/api/appointments/cancel-request/route.ts">
import { NextResponse } from "next/server";
import { createClient as createServerClient } from "@/utils/supabase/server";
import { createAdminClient } from "@/utils/supabase/server";
import { z } from "zod";

const cancelRequestSchema = z.object({
  appointment_id: z.string().uuid("Geçersiz randevu ID"),
  reason: z.string().max(500, "Açıklama en fazla 500 karakter olmalı").optional(),
});

export async function POST(req: Request) {
  try {
    const supabaseUser = await createServerClient();
    const { data: { user } } = await supabaseUser.auth.getUser();

    if (!user) {
      return NextResponse.json({ error: "Giriş yapmanız gerekiyor." }, { status: 401 });
    }

    const body = await req.json();
    const parsed = cancelRequestSchema.safeParse(body);
    if (!parsed.success) {
      const msg = parsed.error.issues.map((e) => `${e.path.join(".")}: ${e.message}`).join("; ");
      return NextResponse.json({ error: msg }, { status: 400 });
    }

    const { appointment_id, reason } = parsed.data;
    const supabaseAdmin = createAdminClient();

    // Randevuyu çek ve sahipliği doğrula
    const { data: appt, error: apptError } = await supabaseAdmin
      .from("appointments")
      .select("id, customer_id, tenant_id, service_id, start_time, status, custom_fields")
      .eq("id", appointment_id)
      .single();

    if (apptError || !appt) {
      return NextResponse.json({ error: "Randevu bulunamadı." }, { status: 404 });
    }

    if (appt.customer_id !== user.id) {
      return NextResponse.json({ error: "Bu randevu size ait değil." }, { status: 403 });
    }

    if (appt.status === "cancelled") {
      return NextResponse.json({ error: "Bu randevu zaten iptal edilmiş." }, { status: 409 });
    }

    if (new Date(appt.start_time).getTime() <= Date.now()) {
      return NextResponse.json({ error: "Geçmiş randevular için istek gönderilemez." }, { status: 409 });
    }

    const prevFields = (appt.custom_fields || {}) as Record<string, unknown>;
    if (prevFields.cancel_requested === true) {
      return NextResponse.json({ error: "Bu randevu için zaten bir iptal isteği gönderilmiş." }, { status: 409 });
    }

    // İstek bayrağını randevuya işle
    const { error: updateError } = await supabaseAdmin
      .from("appointments")
      .update({
        custom_fields: {
          ...prevFields,
          cancel_requested: true,
          cancel_reason: reason || "",
          cancel_requested_at: new Date().toISOString(),
        },
      })
      .eq("id", appointment_id);

    if (updateError) {
      return NextResponse.json({ error: "İstek kaydedilemedi: " + updateError.message }, { status: 500 });
    }

    // İşletmeye bildirim bırak
    const { data: profile } = await supabaseAdmin
      .from("profiles")
      .select("full_name")
      .eq("id", user.id)
      .single();

    const { data: service } = await supabaseAdmin
      .from("services")
      .select("name")
      .eq("id", appt.service_id)
      .single();

    const customerName = (profile?.full_name as string) || "Bir müşteri";
    const serviceName = (service?.name as string) || "Randevu";
    const startStr = new Date(appt.start_time).toLocaleString("tr-TR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });

    const message = `${customerName}, ${startStr} tarihli ${serviceName} randevusu için iptal talebinde bulundu.${reason ? ` Sebep: ${reason}` : ""}`;

    const { error: notifError } = await supabaseAdmin.from("notifications").insert({
      tenant_id: appt.tenant_id,
      title: "Randevu İptal Talebi",
      message,
      is_read: false,
    });

    if (notifError) {
      console.error("Cancel-request notification insert error:", notifError);
    }

    return NextResponse.json({ success: true });
  } catch (err: any) {
    console.error("Cancel-request error:", err);
    return NextResponse.json({ error: err.message || "Bir hata oluştu." }, { status: 500 });
  }
}

// İptal isteğini geri çek (müşteri vazgeçti)
export async function DELETE(req: Request) {
  try {
    const supabaseUser = await createServerClient();
    const { data: { user } } = await supabaseUser.auth.getUser();

    if (!user) {
      return NextResponse.json({ error: "Giriş yapmanız gerekiyor." }, { status: 401 });
    }

    const { searchParams } = new URL(req.url);
    const appointment_id = searchParams.get("appointment_id");

    if (!appointment_id) {
      return NextResponse.json({ error: "Randevu ID gerekli." }, { status: 400 });
    }

    const supabaseAdmin = createAdminClient();

    const { data: appt, error: apptError } = await supabaseAdmin
      .from("appointments")
      .select("id, customer_id, tenant_id, service_id, start_time, status, custom_fields")
      .eq("id", appointment_id)
      .single();

    if (apptError || !appt) {
      return NextResponse.json({ error: "Randevu bulunamadı." }, { status: 404 });
    }

    if (appt.customer_id !== user.id) {
      return NextResponse.json({ error: "Bu randevu size ait değil." }, { status: 403 });
    }

    const prevFields = (appt.custom_fields || {}) as Record<string, unknown>;
    if (prevFields.cancel_requested !== true) {
      return NextResponse.json({ error: "Bu randevu için aktif bir iptal isteği yok." }, { status: 409 });
    }

    const { cancel_requested, cancel_reason, cancel_requested_at, ...rest } = prevFields;

    const { error: updateError } = await supabaseAdmin
      .from("appointments")
      .update({ custom_fields: rest })
      .eq("id", appointment_id);

    if (updateError) {
      return NextResponse.json({ error: "İstek geri çekilemedi: " + updateError.message }, { status: 500 });
    }

    // İşletmeye bilgi notu bırak
    const { data: profile } = await supabaseAdmin
      .from("profiles")
      .select("full_name")
      .eq("id", user.id)
      .single();

    const { data: service } = await supabaseAdmin
      .from("services")
      .select("name")
      .eq("id", appt.service_id)
      .single();

    const customerName = (profile?.full_name as string) || "Bir müşteri";
    const serviceName = (service?.name as string) || "Randevu";
    const startStr = new Date(appt.start_time).toLocaleString("tr-TR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });

    const { error: notifError } = await supabaseAdmin.from("notifications").insert({
      tenant_id: appt.tenant_id,
      title: "İptal Talebi Geri Çekildi",
      message: `${customerName}, ${startStr} tarihli ${serviceName} randevusu için gönderdiği iptal talebini geri çekti. Randevu geçerliliğini koruyor.`,
      is_read: false,
    });

    if (notifError) {
      console.error("Cancel-withdraw notification insert error:", notifError);
    }

    return NextResponse.json({ success: true });
  } catch (err: any) {
    console.error("Cancel-withdraw error:", err);
    return NextResponse.json({ error: err.message || "Bir hata oluştu." }, { status: 500 });
  }
}
