      .eq("tenant_id", tenantId)
      .in("role", ["owner", "staff"])
      .eq("is_active", true)
      .order("created_at", { ascending: true });

    if (error) throw error;

    // Elemana özel ayarlar: randevu akışı, seçilen elemanın saat ve kuralları
