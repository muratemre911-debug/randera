CREATE POLICY "appointments_staff_update_own" ON public.appointments
  AS PERMISSIVE FOR UPDATE TO authenticated
  USING (staff_id = auth.uid())
  WITH CHECK (staff_id = auth.uid());

-- --- Eleman: kendi randevularını silebilir --------------------------------
