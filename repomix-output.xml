import { NextResponse } from "next/server";
import { createClient as createServerClient } from "@/utils/supabase/server";
import { createAdminClient } from "@/utils/supabase/server";
import webpush from "web-push";
import { format } from "date-fns";
import { tr } from "date-fns/locale";
import { bookAppointmentSchema, validateRequest } from "@/lib/validations";
import { isTrMobile } from "@/lib/phone";

const DAY_NAME_TO_SLOT: Record<string, string> = {
  Mon: "pazartesi",
  Tue: "sali",
  Wed: "carsamba",
  Thu: "persembe",
  Fri: "cuma",
  Sat: "cumartesi",
  Sun: "pazar",
};

interface WorkingDay {
  isOpen?: boolean;
  openTime?: string;
  closeTime?: string;
}

function getWeekdayInTr(d: Date): string {
  const short = new Intl.DateTimeFormat("en-US", {
    timeZone: "Europe/Istanbul",
    weekday: "short",
  }).format(d);
  return DAY_NAME_TO_SLOT[short] || "";
}

function getTimeOfDay(d: Date): { h: number; m: number } {
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Istanbul",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).formatToParts(d);
  let h = parseInt(parts.find((p) => p.type === "hour")?.value || "0", 10);
  const m = parseInt(parts.find((p) => p.type === "minute")?.value || "0", 10);
  if (h === 24) h = 0;
  return { h, m };
}

function toMinutes(value: string | undefined): number | null {
  if (!value) return null;
  const [h, m] = value.split(":").map(Number);
  if (Number.isNaN(h) || Number.isNaN(m)) return null;
  return h * 60 + m;
}

export async function POST(req: Request) {
  try {
    const supabaseUser = await createServerClient();
    const {
      data: { user },
    } = await supabaseUser.auth.getUser();

    if (!user) {
      return NextResponse.json(
        { error: "Giriş yapmanız gerekiyor." },
        { status: 401 },
      );
    }

    const body = await req.json();
    const validation = validateRequest(bookAppointmentSchema, body);
    if (!validation.success) {
      return NextResponse.json({ error: validation.error }, { status: 400 });
    }

    const { tenant_id, service_id, staff_id, start_time, end_time, note } =
      validation.data;

    const start = new Date(start_time);
    const end = new Date(end_time);

    if (isNaN(start.getTime()) || isNaN(end.getTime())) {
      return NextResponse.json(
        { error: "Geçersiz randevu zamanı." },
        { status: 400 },
      );
    }

    if (end <= start) {
      return NextResponse.json(
        { error: "Bitiş zamanı başlangıç zamanından sonra olmalı." },
        { status: 400 },
      );
    }

    const supabaseAdmin = createAdminClient();

    // Hizmetin bu işletmeye ait ve aktif olduğunu doğrula
    const { data: service, error: serviceError } = await supabaseAdmin
      .from("services")
      .select("id, tenant_id, is_active, name, staff_id")
      .eq("id", service_id)
      .single();

    if (serviceError || !service) {
      return NextResponse.json(
        { error: "Hizmet bulunamadı." },
        { status: 404 },
      );
    }

    if (service.tenant_id !== tenant_id) {
      return NextResponse.json(
        { error: "Seçilen hizmet bu işletmeye ait değil." },
        { status: 400 },
      );
    }

    if (service.is_active === false) {
      return NextResponse.json(
        { error: "Bu hizmet şu anda randevu almaya kapalı." },
        { status: 400 },
      );
    }

    // Eleman doğrulama: istekte gelmezse hizmetin elemanı kullanılır.
    // Hizmetin staff_id'si ile istekteki staff_id çelişirse istek reddedilir.
    const requestedStaffId = staff_id ?? service.staff_id ?? null;
    let staffName = "";

    if (requestedStaffId) {
      const { data: staff } = await supabaseAdmin
        .from("profiles")
        .select("id, full_name, tenant_id, role")
        .eq("id", requestedStaffId)
        .maybeSingle();

      if (!staff || staff.tenant_id !== tenant_id) {
        return NextResponse.json(
          { error: "Seçilen eleman bu işletmeye ait değil." },
          { status: 400 },
        );
      }

      if (!["owner", "staff"].includes(staff.role)) {
        return NextResponse.json(
          { error: "Seçilen kişi bu işletmede randevu veremez." },
          { status: 400 },
        );
      }

      if (service.staff_id && service.staff_id !== requestedStaffId) {
        return NextResponse.json(
          { error: "Bu hizmeti seçilen eleman vermiyor." },
          { status: 400 },
        );
      }

      staffName = staff.full_name || "";
    }

    // Çalışma saatleri doğrulama
    // Önce elemanın kendi aktif saatleri bakılır (staff_settings):
    // seçilen eleman o gün için saat ayarladıysa onlar, yoksa işletmenin
    // saatleri (tenants.working_hours) uygulanır.
    const { data: tenant } = await supabaseAdmin
      .from("tenants")
      .select("working_hours")
      .eq("id", tenant_id)
      .single();

    const workingHours = tenant?.working_hours as Record<
      string,
      WorkingDay
    > | null;

    let staffHours: Record<string, WorkingDay> | null = null;
    let staffRules: { autoApprove?: boolean } | null = null;
    if (requestedStaffId) {
      const { data: staffSettings } = await supabaseAdmin
        .from("staff_settings")
        .select("working_hours, booking_rules")
        .eq("profile_id", requestedStaffId)
        .maybeSingle();
      staffHours =
        (staffSettings?.working_hours as Record<string, WorkingDay> | null) ??
        null;
      staffRules =
        (staffSettings?.booking_rules as { autoApprove?: boolean } | null) ??
        null;
    }

    const dayName = getWeekdayInTr(start);
    // Elemanın o güne ait ayarı varsa o, yoksa işletmeninki geçerli olur.
    const day = staffHours?.[dayName] ?? workingHours?.[dayName] ?? null;

    if (day) {
      if (day.isOpen === false) {
        return NextResponse.json(
          {
            error:
              staffHours?.[dayName] != null
                ? "Bu gün seçilen eleman çalışmıyor."
                : "Bu gün işletme kapalı.",
          },
          { status: 409 },
        );
      }

      if (day.isOpen === true) {
        const openMin = toMinutes(day.openTime);
        const closeMin = toMinutes(day.closeTime);
        const startMin = getTimeOfDay(start).h * 60 + getTimeOfDay(start).m;
        const endMin = getTimeOfDay(end).h * 60 + getTimeOfDay(end).m;

        if (openMin !== null && startMin < openMin) {
          return NextResponse.json(
            { error: "Randevu çalışma saatleri dışında." },
            { status: 409 },
          );
        }
        if (closeMin !== null && endMin > closeMin) {
          return NextResponse.json(
            { error: "Randevu çalışma saatleri dışında." },
            { status: 409 },
          );
        }
      }
    }

    // Çakışma kontrolü — eleman bazlı (iptal edilmiş randevular hariç)
    let conflictQuery = supabaseAdmin
      .from("appointments")
      .select("id")
      .eq("tenant_id", tenant_id)
      .neq("status", "cancelled")
      .lt("start_time", end_time)
      .gt("end_time", start_time);

    // Eleman seçiliyse aynı elemanın takvimi kontrol edilir; seçili değilse
    // (eski akış) işletme genelinde çakışma aranır.
    if (requestedStaffId) {
      conflictQuery = conflictQuery.eq("staff_id", requestedStaffId);
    }

    const { data: conflicts } = await conflictQuery;

    if (conflicts && conflicts.length > 0) {
      return NextResponse.json(
        {
          error: requestedStaffId
            ? "Seçilen elemanın bu saatte başka bir randevusu var."
            : "Bu zaman aralığı zaten dolu.",
        },
        { status: 409 },
      );
    }

    // Müşteri adını ve telefonunu sunucu tarafında çek
    const { data: profile } = await supabaseAdmin
      .from("profiles")
      .select("full_name, phone, avatar_url")
      .eq("id", user.id)
      .single();

    // Numara kayıtlı olsa bile geçersiz olabilir (eski, uydurma kayıtlar);
    // randevu yalnızca geçerli bir numarayla oluşturulur.
    if (!isTrMobile(profile?.phone)) {
      return NextResponse.json(
        {
          error:
            "Randevu oluşturmak için lütfen profilinize geçerli bir telefon numarası ekleyin.",
        },
        { status: 400 },
      );
    }

    const customerName = profile?.full_name || "Bir müşteri";
    const customerPhone = profile?.phone || "";

    // İşletmenin randevu kuralları: "Otomatik onay" açıksa randevu doğrudan
    // onaylanır. Bu ayar Ayarlar ekranında kullanıcıya "yeni randevular direkt
    // kabul edilir" diye sunuluyor; burada okunmadığı için her randevu
    // "pending" kalıyordu ve ayar hiçbir işe yaramıyordu.
    const { data: tenantRules } = await supabaseAdmin
      .from("tenants")
      .select("booking_rules")
      .eq("id", tenant_id)
      .maybeSingle();

    const autoApprove =
      staffRules?.autoApprove ??
      (tenantRules?.booking_rules as { autoApprove?: boolean } | null)
        ?.autoApprove ??
      false;
    const appointmentStatus = autoApprove ? "confirmed" : "pending";

    // 1. Randevuyu kaydet (otomatik onay kapalıysa onay bekliyor)
    const { error: apptError } = await supabaseAdmin
      .from("appointments")
      .insert({
        tenant_id,
        customer_id: user.id,
        service_id,
        staff_id: requestedStaffId,
        start_time,
        end_time,
        status: appointmentStatus,
        custom_fields: {
          customer_name: customerName,
          note: note || "",
          phone: customerPhone,
          avatar_url: profile?.avatar_url || "",
        },
      });

    if (apptError) {
      return NextResponse.json({ error: apptError.message }, { status: 500 });
    }

    // 2. İşletmeye in-app bildirim kaydet
    const formattedDate = format(new Date(start_time), "dd MMMM yyyy HH:mm", {
      locale: tr,
    });
    const staffSuffix = staffName ? ` Personel: ${staffName}.` : "";
    const message = autoApprove
      ? `${customerName} (${customerPhone}), ${formattedDate} için ${service.name} randevusu aldı ve otomatik olarak onaylandı.${staffSuffix}`
      : `${customerName} (${customerPhone}), ${formattedDate} için ${service.name} randevusu talep etti.${staffSuffix} Onayınızı bekliyor.`;

    const { error: notifError } = await supabaseAdmin
      .from("notifications")
      .insert({
        tenant_id,
        title: autoApprove
          ? "Yeni Randevu (Otomatik Onaylandı)"
          : "Yeni Randevu Talebi (Onay Bekliyor)",
        message,
        is_read: false,
      });

    if (notifError) {
      console.error("Notification insert error:", notifError);
    }

    // 3. Web Push ile cihaz bildirimi gönder
    const vapidPublic = process.env.NEXT_PUBLIC_VAPID_PUBLIC_KEY;
    const vapidPrivate = process.env.VAPID_PRIVATE_KEY;

    if (vapidPublic && vapidPrivate) {
      webpush.setVapidDetails(
        "mailto:test@example.com",
        vapidPublic,
        vapidPrivate,
      );

      const { data: subscriptions } = await supabaseAdmin
        .from("push_subscriptions")
        .select("*")
        .eq("tenant_id", tenant_id);

      if (subscriptions && subscriptions.length > 0) {
        const pushTitle = autoApprove
          ? "Yeni Randevu (Otomatik Onaylandı)"
          : "Yeni Randevu Talebi (Onay Bekliyor)";
        const pushBody = autoApprove
          ? `${customerName}, ${formattedDate} için ${service.name} randevusu aldı ve otomatik onaylandı.${staffSuffix}`
          : `${customerName}, ${formattedDate} için ${service.name} randevusu oluşturdu. Onaylamak için dokunun.${staffSuffix}`;
        const payload = JSON.stringify({ title: pushTitle, body: pushBody });

        await Promise.allSettled(
          subscriptions.map((sub) => {
            const pushSub = {
              endpoint: sub.endpoint,
              keys: {
                auth: sub.auth,
                p256dh: sub.p256dh,
              },
            };
            return webpush
              .sendNotification(pushSub, payload)
              .catch((e: { statusCode?: number }) => {
                if (e.statusCode === 410 || e.statusCode === 404) {
                  supabaseAdmin
                    .from("push_subscriptions")
                    .delete()
                    .eq("endpoint", sub.endpoint)
                    .then();
                }
              });
          }),
        );
      }
    }

    return NextResponse.json({ success: true });
  } catch (err) {
    const message = err instanceof Error ? err.message : "Sunucu hatası";
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
</file>

<file path="src/app/dashboard/icerikler/page.tsx">
"use client";

import { useEffect, useState, useRef } from "react";
import { useRouter } from "next/navigation";
import { ImagePlus } from "lucide-react";
import { createClient } from "@/utils/supabase/client";
import { useLanguage } from "@/context/LanguageContext";
import { PostGrid, PostGridSkeleton } from "@/components/PostGrid";
import { PostModal } from "@/components/PostModal";
import { Post, Tenant } from "@/types";

interface PostWithTenant extends Post {
  tenant?: Pick<Tenant, "id" | "name" | "profile_image_url">;
}

/** Bilinmeyen (unknown) hata değerinden gösterilebilir mesaj çıkarır. */
function errorMessage(err: unknown, fallback: string): string {
  return err instanceof Error && err.message ? err.message : fallback;
}

export default function IceriklerPage() {
  const supabase = createClient();
  const { lang } = useLanguage();
  const router = useRouter();

  const [posts, setPosts] = useState<PostWithTenant[]>([]);
  const [loading, setLoading] = useState(true);
  const [tenantId, setTenantId] = useState<string | null>(null);
  /**
   * İçerikler bölümü yalnızca işletme sahibine aittir. Eleman URL'den
   * doğrudan gelse bile içerik göremez/yönetemez: yetkisizde sayfa hiç
   * render edilmez ve panele yönlendirilir.
   */
  const [denied, setDenied] = useState(false);

  const [description, setDescription] = useState("");
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState("");
  const [uploading, setUploading] = useState(false);
  const [message, setMessage] = useState({ type: "", text: "" });
  const fileInputRef = useRef<HTMLInputElement>(null);

  const [selectedPost, setSelectedPost] = useState<PostWithTenant | null>(null);
  const [modalOpen, setModalOpen] = useState(false);

  const fetchPosts = async () => {
    setLoading(true);
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) {
      setLoading(false);
      return;
    }
    const { data: profile } = await supabase
      .from("profiles")
      .select("tenant_id, role")
      .eq("id", user.id)
      .single();
    if (!profile?.tenant_id) {
      setLoading(false);
      return;
    }

    // Eleman içerikleri göremez ve yönetemez.
    if (profile.role !== "owner") {
      setDenied(true);
      router.replace("/dashboard");
      return;
    }

    setTenantId(profile.tenant_id);

    const res = await fetch(`/api/posts?tenant_id=${profile.tenant_id}`);
    const data = await res.json();
    if (Array.isArray(data)) {
      const tenantRes = await fetch(`/api/tenant/${profile.tenant_id}`);
      const tenantData = await tenantRes.json();
      const tenant = tenantData?.tenant;
      const postsWithTenant = data.map((post: Post) => ({
        ...post,
        tenant: tenant ? { id: tenant.id, name: tenant.name, profile_image_url: tenant.profile_image_url } : undefined,
      }));
      setPosts(postsWithTenant);
    }
    setLoading(false);
  };

  useEffect(() => {
    // Mount'ta içerikleri çekme. fetchPosts async olsa da ilk işi
    // setLoading(true) olduğu için kural tetikleniyor; burada kasıtlı.
    // eslint-disable-next-line react-hooks/set-state-in-effect
    fetchPosts();
  }, []);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const f = e.target.files?.[0];
    if (!f) return;
    setFile(f);
    setPreview(URL.createObjectURL(f));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!file || !tenantId) return;
    setUploading(true);
    setMessage({ type: "", text: "" });

    try {
      const ext = file.name.split(".").pop() || "jpg";
      const filePath = `public/${tenantId}/${Date.now()}.${ext}`;

      const { error: uploadError } = await supabase.storage
        .from("posts")
        .upload(filePath, file, { upsert: false, contentType: file.type });

      if (uploadError) {
        setMessage({ type: "error", text: lang === "tr" ? "Fotoğraf yüklenirken hata oluştu." : "Error uploading photo." });
        setUploading(false);
        return;
      }

      const { data } = supabase.storage.from("posts").getPublicUrl(filePath);
      const imageUrl = data.publicUrl;

      const res = await fetch("/api/posts", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ image_url: imageUrl, description }),
      });
      const resData = await res.json();
      if (!res.ok || resData.error) {
        setMessage({ type: "error", text: resData.error || (lang === "tr" ? "Gönderi oluşturulurken hata." : "Error creating post.") });
      } else {
        setDescription("");
        setFile(null);
        setPreview("");
        if (fileInputRef.current) fileInputRef.current.value = "";
        setMessage({ type: "success", text: lang === "tr" ? "İçerik başarıyla eklendi." : "Content added successfully." });
        fetchPosts();
      }
    } catch (err) {
      setMessage({
        type: "error",
        text: errorMessage(
          err,
          lang === "tr" ? "Beklenmeyen bir hata oluştu." : "Something went wrong.",
        ),
      });
    } finally {
      setUploading(false);
    }
  };

  const [featuredPostIds, setFeaturedPostIds] = useState<string[]>([]);

  useEffect(() => {
    if (tenantId) {
      const saved = localStorage.getItem(`tenant_featured_posts_${tenantId}`);
      if (saved) {
        try {
          // localStorage'da saklanan öne çıkarılan gönderi listesi mount'ta
          // state'e alınıyor; dış sistemden okuma olduğu için kasıtlı.
          // eslint-disable-next-line react-hooks/set-state-in-effect
          setFeaturedPostIds(JSON.parse(saved));
        } catch (e) {
          console.error(e);
        }
      }
    }
  }, [tenantId]);

  const handleToggleFeature = (postId: string) => {
    setFeaturedPostIds((prev) => {
      const next = prev.includes(postId)
        ? prev.filter((id) => id !== postId)
        : [...prev, postId];
      if (tenantId) {
        localStorage.setItem(`tenant_featured_posts_${tenantId}`, JSON.stringify(next));
      }
      return next;
    });
  };

  const handleDelete = async (id: string) => {
    if (!confirm(lang === "tr" ? "Bu içeriği silmek istediğinize emin misiniz?" : "Are you sure you want to delete this post?")) return;
    const res = await fetch(`/api/posts?id=${id}`, { method: "DELETE" });
    if (res.ok) fetchPosts();
  };

  const handleLikeToggle = async (postId: string) => {
    const res = await fetch(`/api/posts/${postId}/like`, { method: "POST" });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error || "Failed to toggle like");
    }
    const data = await res.json();

    setPosts((prevPosts) =>
      prevPosts.map((p) =>
        p.id === postId
          ? { ...p, user_has_liked: data.liked, like_count: data.likeCount }
          : p
      )
    );

    setSelectedPost((prev) =>
      prev && prev.id === postId
        ? { ...prev, user_has_liked: data.liked, like_count: data.likeCount }
        : prev
    );

    return data;
  };

  const handleAddComment = async (postId: string, text: string) => {
    const res = await fetch(`/api/posts/${postId}/comment`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ text }),
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error || "Failed to add comment");
    }
    const data = await res.json();

    setPosts((prevPosts) =>
      prevPosts.map((p) =>
        p.id === postId
          ? { ...p, comment_count: data.commentCount ?? ((p.comment_count || 0) + 1) }
          : p
      )
    );

    setSelectedPost((prev) =>
      prev && prev.id === postId
        ? { ...prev, comment_count: data.commentCount ?? ((prev.comment_count || 0) + 1) }
        : prev
    );

    return data;
  };

  const handlePostClick = (post: PostWithTenant) => {
    setSelectedPost(post);
    setModalOpen(true);
  };

  // Yetkisiz (eleman): sayfa hiç gösterilmez, panel'e yönlendirme yapılıyor.
  if (denied) return null;

  return (
    <div className="animate-in fade-in slide-in-from-bottom-4 duration-700 max-w-6xl mx-auto space-y-6">
      <div>
        <h1 className="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
          {lang === "tr" ? "İçerikler & Galeri" : "Posts & Gallery"}
        </h1>
        <p className="mt-1 text-sm font-medium text-gray-500 dark:text-slate-400">
          {lang === "tr" ? "İşletme profilinizde ve vitrininizde görünecek fotoğraf ve açıklamaları yönetin." : "Manage photos and descriptions for your business showcase."}
        </p>
      </div>

      {/* İki Sütunlu Yerleşim */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* Sol Sütun: Yeni fotoğraf yükleme alanı ve açıklama formu */}
        <div className="lg:col-span-5 lg:sticky lg:top-6">
          <div className="rounded-3xl border border-slate-200 bg-white/80 p-6 backdrop-blur-2xl shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
            <h2 className="text-lg font-bold text-gray-900 dark:text-white mb-4">
              {lang === "tr" ? "Yeni Fotoğraf Yükle" : "Upload New Photo"}
            </h2>

            <form onSubmit={handleSubmit} className="space-y-4">
              {message.text && (
                <div className={`p-3.5 rounded-2xl text-sm font-medium ${message.type === "success" ? "bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-800/50" : "bg-red-50 text-red-700 border border-red-200 dark:bg-red-950/40 dark:text-red-400 dark:border-red-800/50"}`}>
                  {message.text}
                </div>
              )}

              <div>
                <label className="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                  {lang === "tr" ? "Fotoğraf Seçimi" : "Select Photo"}
                </label>
                <div
                  onClick={() => fileInputRef.current?.click()}
                  className="flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 p-6 hover:border-indigo-500 hover:bg-indigo-50/20 dark:hover:bg-slate-800/50 transition-all group"
                >
                  {preview ? (
                    <img src={preview} alt="Önizleme" className="max-h-52 w-full rounded-xl object-cover" />
                  ) : (
                    <div className="flex flex-col items-center gap-2 text-slate-400 group-hover:text-indigo-600 transition-colors py-4">
                      <div className="h-12 w-12 rounded-full bg-indigo-50 dark:bg-indigo-950/50 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
                        <ImagePlus size={24} />
                      </div>
                      <span className="text-sm font-bold">{lang === "tr" ? "Görsel seçmek için tıklayın" : "Click to choose photo"}</span>
                      <span className="text-xs text-slate-400">JPG, PNG, WEBP</span>
                    </div>
                  )}
                </div>
                <input ref={fileInputRef} type="file" accept="image/*" onChange={handleFileChange} className="hidden" />
              </div>

              <div>
                <label className="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                  {lang === "tr" ? "Açıklama" : "Description"}
                </label>
                <textarea
                  value={description}
                  onChange={(e) => setDescription(e.target.value)}
                  rows={3}
                  placeholder={lang === "tr" ? "Bu çalışma veya model hakkında açıklama ekleyin..." : "Write a description..."}
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50/70 px-4 py-3 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800/60 dark:text-white dark:focus:bg-slate-800 resize-none"
                />
              </div>

              <button
                type="submit"
                disabled={uploading || !file}
                className="w-full rounded-2xl bg-indigo-600 px-4 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-500/30 transition-all hover:bg-indigo-500 active:scale-95 disabled:opacity-50"
              >
                {uploading ? (lang === "tr" ? "Yükleniyor..." : "Uploading...") : (lang === "tr" ? "Fotoğrafı Yayınla" : "Publish Photo")}
              </button>
            </form>
          </div>
        </div>

        {/* Sağ Sütun: Yüklenen fotoğrafların yer aldığı 3'lü/4'lü Instagram tarzı grid galeri */}
        <div className="lg:col-span-7 space-y-4">
          <div className="flex items-center justify-between">
            <h2 className="text-lg font-bold text-gray-900 dark:text-white">
              {lang === "tr" ? "Vitrin / Galeri Fotoğrafları" : "Showcase Photos"}
            </h2>
            <span className="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              {posts.length} {lang === "tr" ? "Fotoğraf" : "Photos"}
            </span>
          </div>

          {loading ? (
            <PostGridSkeleton />
          ) : (
            <PostGrid
              posts={posts}
              onPostClick={handlePostClick}
              onDelete={handleDelete}
              onToggleFeature={handleToggleFeature}
              featuredPostIds={featuredPostIds}
              columns={3}
              isLoading={false}
            />
          )}
        </div>
      </div>

      <PostModal
        post={selectedPost}
        isOpen={modalOpen}
        onClose={() => setModalOpen(false)}
        onLikeToggle={handleLikeToggle}
        onAddComment={handleAddComment}
      />
    </div>
  );
}
</file>

