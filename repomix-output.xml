        {[
          { num: 1, labelTr: "1. Hizmet Seçimi", labelEn: "1. Service" },
          { num: 2, labelTr: "2. Tarih & Saat", labelEn: "2. Date & Time" },
          { num: 3, labelTr: "3. Onay & Not", labelEn: "3. Confirm" },
